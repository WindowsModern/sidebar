<UserControl x:Class="Sidebar.FlyoutMask"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sidebar"
             mc:Ignorable="d" x:Name="self"
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid Panel.ZIndex="9999" Background="#80FFFFFF" Name="LoadingFlyout" Opacity="0" Visibility="Collapsed">
		<Border Width="Auto" Height="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6">
			<Border.Effect>
				<DropShadowEffect BlurRadius="18" ShadowDepth="1" Opacity="0.35" />
			</Border.Effect>
			<Grid>
				<Border CornerRadius="6" Background="#90FFFFFF" BorderBrush="#90A8BED4" BorderThickness="1" />
				<Border Margin="1" CornerRadius="5" Background="#30FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" />
				<ContentPresenter  Content="{Binding Child, ElementName=self}"></ContentPresenter>
				<ContentPresenter ContentTemplate="{Binding FlyoutTemplate, ElementName=self}"/>
			</Grid>
		</Border>
	</Grid>
</UserControl>
