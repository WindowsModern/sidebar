<Window x:Class="Sidebar.SettingsWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sidebar Gadget Store Settings"
        Width="420"
        Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
		SizeToContent="Height" Loaded="Window_Loaded"
        Background="#FFF7F7F7">
	<Window.Resources>
		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#333"/>
			<Setter Property="Margin" Value="0,0,0,12"/>
		</Style>
		<Style x:Key="AeroButton" TargetType="Button">
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="18,0"/>
			<Setter Property="Background">
				<Setter.Value>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Color="#FFFFFF" Offset="0"/>
						<GradientStop Color="#D8E8F7" Offset="1"/>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter>
			<Setter Property="BorderBrush" Value="#8AA9C5"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</Window.Resources>
	<Grid>
		<Grid.Resources>
			<Style TargetType="TextBlock">
				<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"></Setter>
			</Style>
		</Grid.Resources>
		<Grid.Background>
			<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
				<GradientStop Color="#F9FCFF" Offset="0"/>
				<GradientStop Color="#E5EFF8" Offset="0.5"/>
				<GradientStop Color="#D6E6F5" Offset="1"/>
			</LinearGradientBrush>
		</Grid.Background>
		<TabControl Margin="12"
                    Background="Transparent"
					SelectionChanged="TabControl_SelectionChanged"
                    BorderThickness="0">
			<TabItem Name="TabGeneral" Header="General">
				<Grid Background="#80FFFFFF">
					<StackPanel Margin="18">
						<TextBlock Name="LabelCurrCache" Text="Current cache:"
                                   Foreground="#555"/>
						<TextBlock Name="CurrCacheDisplay"
                                   Text="0 KB"
                                   Margin="0,3,0,15"
                                   Foreground="#777"/>
						<Button Name="ButtonClear"
                                Content="Clean Cache"
                                Style="{StaticResource AeroButton}"
                                HorizontalAlignment="Left"
                                Click="ButtonClear_Click"/>
					</StackPanel>
				</Grid>
			</TabItem>
			<TabItem Name="TabAbout" Header="About">
				<Grid x:Name="AboutContent"
          Background="#80FFFFFF">
					<StackPanel Margin="25,30,25,20">
						<TextBlock Name="LabelAppTitle" Text="Sidebar Gadget Store"
                       FontSize="24"
                       Foreground="#333"/>
						<TextBlock Name="LabelVersion" Text="Version 1.0"
                       FontSize="12"
                       Foreground="#666"
                       Margin="0,6,0,18"/>
						<TextBlock Name="LabelIntroduction" Text="A Longhorn inspired Sidebar platform"
                       FontSize="13"
                       Foreground="#555"
                       TextWrapping="Wrap"/>
						<Separator Margin="0,25,0,12"/>
						<TextBlock Name="LabelDisclaimer" Text="Provides a modern gadget experience for Windows."
                       FontSize="11"
                       Foreground="#555"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
						<TextBlock Name="LabelCopyright" Text="Copyright © 2026"
                       Foreground="#777" Margin="0,10"/>
					</StackPanel>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</Window>