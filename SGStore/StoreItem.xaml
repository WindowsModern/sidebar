<UserControl x:Class="Sidebar.StoreItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Height="60"
             Width="220">
	<UserControl.Resources>
		<!-- 基础背景（透明） -->
		<SolidColorBrush x:Key="BaseBackground" Color="Transparent" />
		<SolidColorBrush x:Key="BaseBorderBrush" Color="Transparent" />

		<!-- 悬停背景渐变 -->
		<LinearGradientBrush x:Key="HoverBackground" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#FFF9FCFF" Offset="0" />
			<GradientStop Color="#FFE2F0FC" Offset="1" />
		</LinearGradientBrush>
		<SolidColorBrush x:Key="HoverBorderBrush" Color="#8CB2D9" />

		<!-- 按下背景渐变 -->
		<LinearGradientBrush x:Key="PressedBackground" StartPoint="0,1" EndPoint="0,0">
			<GradientStop Color="#FFD3E7FA" Offset="0" />
			<GradientStop Color="#FFF3F8FD" Offset="1" />
		</LinearGradientBrush>
		<SolidColorBrush x:Key="PressedBorderBrush" Color="#8CB2D9" />

		<!-- Vista 风格按钮模板 -->
		<Style x:Key="VistaStoreButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<!-- 默认背景（透明） -->
							<Border x:Name="DefaultBorder"
                                    CornerRadius="4"
                                    Margin="1"
                                    Background="{StaticResource BaseBackground}"
                                    BorderBrush="{StaticResource BaseBorderBrush}"
                                    BorderThickness="1" />

							<!-- 悬停背景（初始透明，悬停时淡入） -->
							<Border x:Name="HoverBorder"
                                    CornerRadius="4"
                                    Margin="1"
                                    Background="{StaticResource HoverBackground}"
                                    BorderBrush="{StaticResource HoverBorderBrush}"
                                    BorderThickness="1"
                                    Opacity="0" />

							<!-- 按下背景（初始透明，按下时淡入） -->
							<Border x:Name="PressedBorder"
                                    CornerRadius="4"
                                    Margin="1"
                                    Background="{StaticResource PressedBackground}"
                                    BorderBrush="{StaticResource PressedBorderBrush}"
                                    BorderThickness="1"
                                    Opacity="0" />

							<!-- 玻璃高光 -->
							<Border x:Name="HighlightBorder"
                                    Margin="2"
                                    Height="18"
                                    VerticalAlignment="Top"
                                    CornerRadius="3"
                                    Opacity="0"
                                    IsHitTestVisible="False">
								<Border.Background>
									<LinearGradientBrush>
										<GradientStop Color="#DFFFFFFF" Offset="0" />
										<GradientStop Color="#00FFFFFF" Offset="1" />
									</LinearGradientBrush>
								</Border.Background>
							</Border>

							<!-- 焦点光晕 -->
							<Border x:Name="FocusBorder"
                                    CornerRadius="5"
                                    BorderThickness="2"
                                    BorderBrush="#6687C7FF"
                                    Opacity="0"
                                    IsHitTestVisible="False" />

							<!-- 内容 -->
							<ContentPresenter VerticalAlignment="Center" />
						</Grid>

						<ControlTemplate.Triggers>
							<!-- 鼠标悬停 -->
							<Trigger Property="IsMouseOver" Value="True">
								<Trigger.EnterActions>
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="HoverBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.15" />
											<DoubleAnimation Storyboard.TargetName="HighlightBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.15" />
										</Storyboard>
									</BeginStoryboard>
								</Trigger.EnterActions>
								<Trigger.ExitActions>
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="HoverBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.2" />
											<DoubleAnimation Storyboard.TargetName="HighlightBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.2" />
										</Storyboard>
									</BeginStoryboard>
								</Trigger.ExitActions>
							</Trigger>

							<!-- 鼠标按下 -->
							<Trigger Property="IsPressed" Value="True">
								<Trigger.EnterActions>
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="PressedBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.08" />
											<!-- 按下时高光变暗 -->
											<DoubleAnimation Storyboard.TargetName="HighlightBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.3"
                                                             Duration="0:0:0.08" />
										</Storyboard>
									</BeginStoryboard>
								</Trigger.EnterActions>
								<Trigger.ExitActions>
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="PressedBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.1" />
											<!-- 恢复高光（如果鼠标仍悬停，则由悬停触发器控制） -->
											<DoubleAnimation Storyboard.TargetName="HighlightBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.1" />
										</Storyboard>
									</BeginStoryboard>
								</Trigger.ExitActions>
							</Trigger>

							<!-- 键盘焦点 -->
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Trigger.EnterActions>
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="FocusBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.2" />
										</Storyboard>
									</BeginStoryboard>
								</Trigger.EnterActions>
								<Trigger.ExitActions>
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="FocusBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.2" />
										</Storyboard>
									</BeginStoryboard>
								</Trigger.ExitActions>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Button Style="{StaticResource VistaStoreButton}" x:Name="InternalButton" Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
        CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}" Click="InternalButton_Click">
		<DockPanel>
			<Image Name="StoreLogo" DockPanel.Dock="Left"
                   Width="50"
                   Height="50"
                   Margin="5"
				   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="{Binding Source, RelativeSource={RelativeSource AncestorType=UserControl}}" />
			<StackPanel Margin="0,5,5,5">
				<TextBlock FontSize="14"
                           TextWrapping="Wrap"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           ToolTip="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
				<TextBlock FontFamily="{DynamicResource GlobalFontFamily}"
                           TextWrapping="Wrap"
                           Text="{Binding Version, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           ToolTip="{Binding Version, RelativeSource={RelativeSource AncestorType=UserControl}}" />
				<TextBlock Foreground="Gray"
                           TextTrimming="WordEllipsis"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           Text="{Binding Publisher, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           ToolTip="{Binding Publisher, RelativeSource={RelativeSource AncestorType=UserControl}}" />
			</StackPanel>
		</DockPanel>
	</Button>
</UserControl>