<UserControl x:Class="SGTheme.Tiles.Clock.FlyoutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SGTheme.Tiles.Clock"
             mc:Ignorable="d" Width="501" Height="324"
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid>
		<Control Style="{DynamicResource FlyoutBackground}" />
		<Button Name="FlyoutHeader" Style="{DynamicResource FlyoutHeader}" VerticalAlignment="Top" />
		<Grid Name="FlyoutContent" Style="{DynamicResource FlyoutContentContainer}">
			<Grid Style="{DynamicResource TileClockFlyoutPanel}">
				<DockPanel LastChildFill="True">
					<local:FlyoutCalendar x:Name="DisplayCalendar" DockPanel.Dock="Right"></local:FlyoutCalendar>
					<StackPanel DockPanel.Dock="Left" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Left">
						<local:ClockFace x:Name="DisplayClock" Style="{DynamicResource TileClockFlyoutClock}"></local:ClockFace>
						<local:FlyoutShortTime x:Name="DisplayShortTime" Style="{DynamicResource TileClockPanelShortTimeText}"></local:FlyoutShortTime>
						<TextBlock Name="DisplayAlarm" Style="{DynamicResource TileClockPanelCommonTextFlyout}">
							<Run Text="♫" />
							<Run Text=" " />
							<Run Name="DisplayAlarmTip" Text="5:34 PM, Apr 24" />
						</TextBlock>
					</StackPanel>
				</DockPanel>
			</Grid>
		</Grid>
		<Control Style="{DynamicResource FlyoutHighlight}" IsHitTestVisible="False" />
	</Grid>
</UserControl>
