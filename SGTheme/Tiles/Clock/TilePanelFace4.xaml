<UserControl x:Class="SGTheme.Tiles.Clock.TilePanelFace4"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SGTheme.Tiles.Clock"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid Style="{DynamicResource TileClockPanelFace4}">
		<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
			<StackPanel>
				<local:TileShortTime x:Name="ClockShortTime" HorizontalContentAlignment="Left"  Style="{DynamicResource TileClockPanelShortTimeText4}"></local:TileShortTime>
				<TextBlock Name="ClockDayInWeek" Style="{DynamicResource TileClockPanelCommonText4}">Sunday</TextBlock>
				<TextBlock Name="ClockDate" Style="{DynamicResource TileClockPanelCommonText4}">May 11, 2026</TextBlock>
			</StackPanel>
		</StackPanel>
	</Grid>
</UserControl>
