<UserControl x:Class="SGTheme.Tiles.Clock.TilePanelFace5"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SGTheme.Tiles.Clock"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid Style="{DynamicResource TileClockPanelFace5}">
		<DockPanel LastChildFill="True">
			<local:ClockFace x:Name="ClockPart" Style="{DynamicResource TileClockPanelClock5}"></local:ClockFace>
			<StackPanel Style="{DynamicResource TileClockPanelTextPart5}">
				<local:TileShortTime x:Name="ShortTime" HorizontalContentAlignment="Left"></local:TileShortTime>
			</StackPanel>
		</DockPanel>
	</Grid>
</UserControl>
