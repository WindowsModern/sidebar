<UserControl x:Class="SGTheme.Sidebar.TileWithBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SGTheme.Sidebar"
             mc:Ignorable="d" Width="150" Height="500"
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid>
		<Grid Name="SidebarView">
			<Control Style="{DynamicResource SidebarBackground}" />
			<Grid>
				<Button Name="TopOptionsButton" Style="{DynamicResource SidebarOptionsTop}" Focusable="False"/>
				<Control Style="{DynamicResource SidebarOptionsSplliter}" />
				<DockPanel Name="TilesContainer" Style="{DynamicResource SidebarTilesRegion}">
					<StackPanel Name="PinnedTilesControl" Style="{DynamicResource SidebarPinnedTilesControl}">
						<local:Tile IsPinned="True"></local:Tile>
						<local:Tile IsPinned="True"></local:Tile>
					</StackPanel>
					<StackPanel Name="TilesControl" Style="{DynamicResource SidebarTilesControl}">
						<local:Tile></local:Tile>
						<local:Tile></local:Tile>
						<Grid Height="100"></Grid>
					</StackPanel>
				</DockPanel>
			</Grid>
			<Control IsHitTestVisible="False" Style="{DynamicResource SidebarHighlightSide}" />
		</Grid>
	</Grid>
</UserControl>
