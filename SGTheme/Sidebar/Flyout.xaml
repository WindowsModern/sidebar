<UserControl x:Class="SGTheme.Sidebar.Flyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid>
		<Control Style="{DynamicResource FlyoutBackground}" />
		<Button Name="FlyoutHeader" Style="{DynamicResource FlyoutHeader}" VerticalAlignment="Top" />
		<Grid Name="FlyoutContent" Style="{DynamicResource FlyoutContentContainer}" />
		<Control Style="{DynamicResource FlyoutHighlight}" IsHitTestVisible="False" />
	</Grid>
</UserControl>
