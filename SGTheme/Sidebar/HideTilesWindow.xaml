<!--
    Preview of Sidebar's HideTilesWindow for SGTheme.
    Uses the same SidebarBackground / SidebarTilesControl / Tile previews as the real window.
-->
<UserControl x:Class="SGTheme.Sidebar.HideTilesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SGTheme.Sidebar"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="150"
             Width="150" Height="480">
	<Grid>
		<Control Style="{DynamicResource SidebarBackground}" />
		<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,19,0,0">
			<StackPanel Style="{DynamicResource SidebarTilesControl}">
				<local:Tile />
				<local:Tile />
				<local:Tile />
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
