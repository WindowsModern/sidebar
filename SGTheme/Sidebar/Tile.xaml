<UserControl x:Class="SGTheme.Sidebar.Tile"
             x:Name="RootTileElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
	<UserControl.Resources>
		<Storyboard x:Key="ShowIconStoryboard">
			<DoubleAnimation Storyboard.TargetName="TileFlyoutIcon" 
                             Storyboard.TargetProperty="Opacity" 
                             To="1" Duration="0:0:0.2"/>
		</Storyboard>
		<Storyboard x:Key="HideIconStoryboard">
			<DoubleAnimation Storyboard.TargetName="TileFlyoutIcon" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0" Duration="0:0:0.2"/>
		</Storyboard>
	</UserControl.Resources>
	<Grid>
		<DockPanel>
			<Thumb Name="Splitter" Style="{DynamicResource TileSplliter}" />
			<Grid Name="TileMainPanel">
				<Control Style="{DynamicResource TileBackground}" />
				<DockPanel>
					<Grid Name="TileHeader" Style="{DynamicResource TileHeaderContainer}">
						<Control Style="{DynamicResource TileHeaderBackground}" />
						<DockPanel>
							<Image Name="TileIcon" Style="{DynamicResource TileHeaderIcon}" />
							<TextBlock Name="TileDisplayName" Text="Title" Style="{DynamicResource TileHeaderDisplayName}" />
						</DockPanel>
						<Control Style="{DynamicResource TileHeaderHighlight}" IsHitTestVisible="False" />
					</Grid>
					<Grid Name="TileContentContainerControl">
						<Control Style="{DynamicResource TileContentBackground}" />
						<Grid Name="TileContent" Style="{DynamicResource TileContentContainer}" MinHeight="0">
							<Border Padding="5" Margin="5" CornerRadius="4" Background="#22000000" BorderThickness="1" BorderBrush="#33000000" Height="50">
								<TextBlock Style="{DynamicResource GlobalTextBlockTextDisplay}">Test Content 测试用内容</TextBlock>
							</Border>
						</Grid>
						<Control Style="{DynamicResource TileContentHighlight}" IsHitTestVisible="False" />
					</Grid>
				</DockPanel>
				<Control Name="TileHighlight" Style="{DynamicResource TileHighlight}" IsHitTestVisible="False" />
			</Grid>
		</DockPanel>
		<Control Name="TileFlyoutIcon" Style="{DynamicResource TileFlyoutIcon}" IsHitTestVisible="True" />
	</Grid>
</UserControl>
