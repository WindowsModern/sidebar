<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:pst="clr-namespace:SGTheme"
                    xmlns:local="clr-namespace:SGTheme">
	<Style x:Key="SidebarBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="Transparent">
						<Border Background="{Binding ThemeBrush, Source={x:Static pst:DwmThemeProvider.Instance}}" />
						<Border x:Name="SideBorder" BorderBrush="#53000000" BorderThickness="1,0,0,0"/>
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{Binding IsReversed, Source={x:Static pst:SidebarUIConfig.Instance}}" Value="True">
							<Setter TargetName="SideBorder" Property="BorderThickness" Value="0,0,1,0" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarOptionsTop" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="{TemplateBinding Background}">
						<StackPanel Name="OptionsBar" Height="{TemplateBinding Height}" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True" Orientation="Horizontal">
							<TextBlock x:Name="OptionsText" VerticalAlignment="Center" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="10" Foreground="{DynamicResource GlobalForegroundBrush}" Opacity="0" Text="{pst:StringResource SIDEBAR_OPTIONS}"></TextBlock>
							<Polygon Name="TopOptionsIcon" VerticalAlignment="Center" Points="0,0 3.5,3.5 7,0" Opacity="0.45" Stroke="#FD000000" StrokeThickness="1" Fill="White" Margin="2,1,2,0" RenderTransformOrigin="0.556,0.9" SnapsToDevicePixels="True" UseLayoutRounding="True" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
						</StackPanel>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIcon" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<DataTrigger Binding="{Binding IsReversed, Source={x:Static pst:SidebarUIConfig.Instance}}" Value="True">
							<Setter TargetName="OptionsBar" Property="HorizontalAlignment" Value="Left" />
							<Setter TargetName="OptionsBar" Property="FlowDirection" Value="RightToLeft" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Height" Value="17" />
		<Setter Property="VerticalAlignment" Value="Top" />
	</Style>
	<Style x:Key="SidebarOptionsSplliter" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="4" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Margin" Value="0,17,0,0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid>
						<Line Name="SplitterLine1" HorizontalAlignment="Stretch" Stretch="Fill" Stroke="#53000000" StrokeThickness="1" X1="0" X2="100" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarTilesRegion" TargetType="DockPanel">
		<Setter Property="Margin" Value="0,19,0,0" />
	</Style>
	<ControlTemplate x:Key="TemplateAutoHideScrollViewer" TargetType="ScrollViewer">
		<Grid Background="{TemplateBinding Background}">
			<ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" />
			<ScrollBar x:Name="PART_VerticalScrollBar" Width="6" Margin="0,0,2,8" HorizontalAlignment="Right" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Opacity="0" />
			<ScrollBar x:Name="PART_HorizontalScrollBar" Height="6" Margin="0,0,8,2" VerticalAlignment="Bottom" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Opacity="0" />
		</Grid>
	</ControlTemplate>
	<Style x:Key="SidebarPinnedTilesScrollControl" TargetType="ScrollViewer">
		<Setter Property="Template" Value="{DynamicResource TemplateAutoHideScrollViewer}"></Setter>
		<Setter Property="local:AutoHideScrollBar.IsEnabled" Value="True"></Setter>
		<Setter Property="DockPanel.Dock" Value="Bottom"></Setter>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
		<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"></Setter>
		<Setter Property="VerticalScrollBarVisibility" Value="Auto"></Setter>
	</Style>
	<Style x:Key="SidebarTilesScrollControl" TargetType="ScrollViewer">
		<Setter Property="Template" Value="{DynamicResource TemplateAutoHideScrollViewer}"></Setter>
		<Setter Property="local:AutoHideScrollBar.IsEnabled" Value="True"></Setter>
		<Setter Property="DockPanel.Dock" Value="Top"></Setter>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
		<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"></Setter>
		<Setter Property="VerticalScrollBarVisibility" Value="Auto"></Setter>
	</Style>
	<Style x:Key="SidebarPinnedTilesControl" TargetType="StackPanel">
		<Setter Property="DockPanel.Dock" Value="Bottom"></Setter>
		<Setter Property="Orientation" Value="Vertical"></Setter>
		<Setter Property="ClipToBounds" Value="True"></Setter>
	</Style>
	<Style x:Key="SidebarTilesControl" TargetType="StackPanel">
		<Setter Property="DockPanel.Dock" Value="Top"></Setter>
		<Setter Property="Orientation" Value="Vertical"></Setter>
		<Setter Property="ClipToBounds" Value="True"></Setter>
	</Style>
	<Style x:Key="SidebarHighlightSide" TargetType="Control">
		<Setter Property="Visibility" Value="Collapsed"></Setter>
	</Style>
	<Style x:Key="SidebarTaskbarTrayBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="Transparent">
						<Border Background="{Binding ThemeBrush, Source={x:Static pst:DwmThemeProvider.Instance}}" />
						<Border x:Name="SideBorder" BorderBrush="#53000000" BorderThickness="0,1,0,0" RenderTransformOrigin="0.5,0.5" />
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{Binding IsTaskbarTop, Source={x:Static pst:SystemExplorerShell.Instance}}" Value="True">
							<Setter TargetName="SideBorder" Property="BorderThickness" Value="0,0,0,1" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarMinRestoreButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
						<Image x:Name="Normal" Source="..\Images\Sidebar\FoldNormal.png" />
						<Image x:Name="Hover" Source="..\Images\Sidebar\FoldLight.png" Opacity="0" />
						<Image x:Name="Active" Source="..\Images\Sidebar\FoldPress.png" Opacity="0" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Width" Value="21" />
		<Setter Property="Height" Value="20" />
		<Setter Property="VerticalAlignment" Value="Center"></Setter>
		<Setter Property="Margin" Value="10,0,2,0"></Setter>
		<Setter Property="DockPanel.Dock" Value="Left"></Setter>
	</Style>
	<Style x:Key="SidebarMinAeroPeekButton" TargetType="Button">
		<Setter Property="Width" Value="8"></Setter>
		<Setter Property="DockPanel.Dock" Value="Right"></Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="PART_Btn" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
						<ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"></ContentPresenter>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_Btn" Property="Background" Value="#99FFFFFF"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="PART_Btn" Property="Background" Value="#4DFFFFFF"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarMinTaskbarTilesControl" TargetType="ItemsControl">
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<Button Tag="{Binding}" ToolTip="{Binding DisplayName}" Content="{Binding Icon}" Width="24">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Border x:Name="BackgroundActive" Opacity="0">
										<Border.Background>
											<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
												<GradientStop Offset="0" Color="Transparent" />
												<GradientStop Offset="0.25" Color="#77000000" />
												<GradientStop Offset="0.75" Color="#77000000" />
												<GradientStop Offset="1" Color="Transparent" />
											</LinearGradientBrush>
										</Border.Background>
									</Border>
									<Border x:Name="BackgroundOuter" Margin="0,3" BorderThickness="1,0" Opacity="0">
										<Border.BorderBrush>
											<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
												<GradientStop Offset="0" Color="Transparent" />
												<GradientStop Offset="0.25" Color="#66000000" />
												<GradientStop Offset="0.75" Color="#66000000" />
												<GradientStop Offset="1" Color="Transparent" />
											</LinearGradientBrush>
										</Border.BorderBrush>
									</Border>
									<Border x:Name="BackgroundInner" Margin="1,3" BorderThickness="1,0" Opacity="0">
										<Border.BorderBrush>
											<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
												<GradientStop Offset="0" Color="Transparent" />
												<GradientStop Offset="0.25" Color="#CCFFFFFF" />
												<GradientStop Offset="0.75" Color="#CCFFFFFF" />
												<GradientStop Offset="1" Color="Transparent" />
											</LinearGradientBrush>
										</Border.BorderBrush>
									</Border>
									<Image Source="{TemplateBinding Content}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
									<Viewbox x:Name="BottonLight" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Opacity="0">
										<Grid Width="20" Height="20" ClipToBounds="True">
											<Ellipse Margin="3,15,3,-7">
												<Ellipse.Fill>
													<RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.5" RadiusY="1">
														<GradientStop Offset="0" Color="White" />
														<GradientStop Offset="1" Color="#00FFFFFF" />
													</RadialGradientBrush>
												</Ellipse.Fill>
											</Ellipse>
										</Grid>
									</Viewbox>
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="BackgroundOuter" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
													<DoubleAnimation Storyboard.TargetName="BackgroundInner" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
													<DoubleAnimation Storyboard.TargetName="BottonLight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="BackgroundOuter" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
													<DoubleAnimation Storyboard.TargetName="BackgroundInner" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
													<DoubleAnimation Storyboard.TargetName="BottonLight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
									<Trigger Property="IsPressed" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="BackgroundActive" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="BackgroundActive" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarOverflowPartSplliter" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="4" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid>
						<Line Name="SplitterLine1" HorizontalAlignment="Stretch" Stretch="Fill" Stroke="#53000000" StrokeThickness="1" X1="0" X2="100" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarOverflowTilesControl" TargetType="ItemsControl">
		<Setter Property="FlowDirection" Value="RightToLeft"></Setter>
		<Setter Property="DockPanel.Dock" Value="Bottom"></Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<WrapPanel FlowDirection="RightToLeft"></WrapPanel>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ItemsControl">
					<StackPanel Orientation="Vertical" Background="{TemplateBinding Background}">
						<Control Style="{DynamicResource SidebarOverflowPartSplliter}" />
						<ItemsPresenter FlowDirection="{TemplateBinding FlowDirection}"/>
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<Button Tag="{Binding}" ToolTip="{Binding DisplayName}" Content="{Binding Icon}" Width="24" Height="24">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Border x:Name="BackgroundActive" Opacity="0">
										<Border.Background>
											<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
												<GradientStop Offset="0" Color="Transparent" />
												<GradientStop Offset="0.25" Color="#77000000" />
												<GradientStop Offset="0.75" Color="#77000000" />
												<GradientStop Offset="1" Color="Transparent" />
											</LinearGradientBrush>
										</Border.Background>
									</Border>
									<Border x:Name="BackgroundOuter" Margin="0,3" BorderThickness="1,0" Opacity="0">
										<Border.BorderBrush>
											<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
												<GradientStop Offset="0" Color="Transparent" />
												<GradientStop Offset="0.25" Color="#66000000" />
												<GradientStop Offset="0.75" Color="#66000000" />
												<GradientStop Offset="1" Color="Transparent" />
											</LinearGradientBrush>
										</Border.BorderBrush>
									</Border>
									<Border x:Name="BackgroundInner" Margin="1,3" BorderThickness="1,0" Opacity="0">
										<Border.BorderBrush>
											<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
												<GradientStop Offset="0" Color="Transparent" />
												<GradientStop Offset="0.25" Color="#CCFFFFFF" />
												<GradientStop Offset="0.75" Color="#CCFFFFFF" />
												<GradientStop Offset="1" Color="Transparent" />
											</LinearGradientBrush>
										</Border.BorderBrush>
									</Border>
									<Image Source="{TemplateBinding Content}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
									<Viewbox x:Name="BottonLight" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Opacity="0">
										<Grid Width="20" Height="20" ClipToBounds="True">
											<Ellipse Margin="3,15,3,-7">
												<Ellipse.Fill>
													<RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.5" RadiusY="1">
														<GradientStop Offset="0" Color="White" />
														<GradientStop Offset="1" Color="#00FFFFFF" />
													</RadialGradientBrush>
												</Ellipse.Fill>
											</Ellipse>
										</Grid>
									</Viewbox>
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="BackgroundOuter" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
													<DoubleAnimation Storyboard.TargetName="BackgroundInner" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
													<DoubleAnimation Storyboard.TargetName="BottonLight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="BackgroundOuter" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
													<DoubleAnimation Storyboard.TargetName="BackgroundInner" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
													<DoubleAnimation Storyboard.TargetName="BottonLight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
									<Trigger Property="IsPressed" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="BackgroundActive" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="BackgroundActive" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarTaskbarTrayHighlight" TargetType="Control">
		<Setter Property="Visibility" Value="Collapsed"></Setter>
	</Style>
	<Storyboard x:Key="SidebarWindowLoaded"></Storyboard>
	<Storyboard x:Key="SidebarShowTaskbarTiles">
		<DoubleAnimation Storyboard.TargetName="TaskbarTiles" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"></DoubleAnimation>
	</Storyboard>
</ResourceDictionary>