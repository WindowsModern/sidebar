<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SGTheme">
	<Style x:Key="MessageWindowWindow" TargetType="Window">
		<Setter Property="ResizeMode" Value="NoResize"></Setter>
	</Style>
	<Style x:Key="MessageWindowTitle" TargetType="TextBlock">
		<Setter Property="TextWrapping" Value="Wrap"></Setter>
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"></Setter>
		<Setter Property="FontSize" Value="18"></Setter>
		<Setter Property="DockPanel.Dock" Value="Top"></Setter>
		<Setter Property="Margin" Value="20,20,20,0"></Setter>
	</Style>
	<Style x:Key="MessageWindowText" TargetType="TextBlock">
		<Setter Property="TextWrapping" Value="Wrap"></Setter>
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"></Setter>
		<Setter Property="FontSize" Value="12"></Setter>
		<Setter Property="Margin" Value="20,10"></Setter>
		<Setter Property="DockPanel.Dock" Value="Top"></Setter>
	</Style>
	<Style x:Key="MessageWindowDetailMessage" TargetType="TextBox">
		<Setter Property="TextWrapping" Value="Wrap"></Setter>
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"></Setter>
		<Setter Property="VerticalScrollBarVisibility" Value="Auto"></Setter>
		<Setter Property="Padding" Value="5"></Setter>
		<Setter Property="IsReadOnly" Value="True"></Setter>
	</Style>
	<Style x:Key="MessageWindowDetailExpander" TargetType="Expander">
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"></Setter>
		<Setter Property="FontSize" Value="12"></Setter>
		<Setter Property="DockPanel.Dock" Value="Top"></Setter>
		<Setter Property="Margin" Value="20,0"></Setter>
	</Style>
	<Style x:Key="MessageWindowButtonAera" TargetType="Grid">
		<Setter Property="Margin" Value="0,10,0,0"></Setter>
		<Setter Property="DockPanel.Dock" Value="Bottom"></Setter>
	</Style>
	<Style x:Key="MessageWindowControlButton" TargetType="Button">
		<Setter Property="Padding" Value="20,5"></Setter>
		<Setter Property="MinWidth" Value="80"></Setter>
		<Setter Property="Margin" Value="10,0,0,0"></Setter>
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"></Setter>
	</Style>
	<Style x:Key="MessageWindowBackground" TargetType="Control">
		<Setter Property="Visibility" Value="Collapsed"></Setter>
	</Style>
	<Style x:Key="MessageWindowControlsBackground" TargetType="Control">
		<Setter Property="Visibility" Value="Collapsed"></Setter>
	</Style>
	<Style x:Key="MessageWindowButtonsContainer" TargetType="StackPanel">
		<Setter Property="HorizontalAlignment" Value="Right"></Setter>
		<Setter Property="Orientation" Value="Horizontal"></Setter>
		<Setter Property="VerticalAlignment" Value="Bottom"></Setter>
		<Setter Property="Margin" Value="20,0,20,20"></Setter>
	</Style>
</ResourceDictionary>