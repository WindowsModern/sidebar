<UserControl x:Class="WindowsModern.FeedTile.TileFeedItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsModern.FeedTile"
             mc:Ignorable="d" SizeChanged="UserControl_SizeChanged"
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid Margin="0,15,0,15">
		<StackPanel Orientation="Horizontal" VerticalAlignment="Top" Background="Transparent" >
			<DockPanel Margin="5,1,0,0">
				<Image DockPanel.Dock="Top" Name="ItemPoint" Style="{DynamicResource TileFeedsTileItemPoint}"></Image>
				<Grid></Grid>
			</DockPanel>
			<TextBlock Name="FeedTitle" Margin="4,0,0,0" TextWrapping="Wrap" Style="{DynamicResource TileFeedTitleNormal}"></TextBlock>
		</StackPanel>
		<Button Name="ClickContainer" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
				MouseEnter="StackPanel_MouseEnter" MouseLeave="StackPanel_MouseLeave" Click="ClickContainer_Click">
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"></Border>
				</ControlTemplate>
			</Button.Template>
		</Button>
	</Grid>
</UserControl>
