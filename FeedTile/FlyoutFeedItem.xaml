<UserControl x:Class="WindowsModern.FeedTile.FlyoutFeedItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsModern.FeedTile"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="100">
	<Grid Margin="0,10,0,10">
		<WrapPanel Orientation="Vertical" Name="FeedItemContainer">
			<TextBlock Name="Title" Style="{DynamicResource TileFeedItemTitle}">Feed Item Title</TextBlock>
			<TextBlock Name="Desc" Style="{DynamicResource TileFeedItemDescription}">Feed Item Content</TextBlock>
		</WrapPanel>
		<Button Name="ClickContainer" Click="ClickContainer_Click" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
				MouseEnter="FeedItemContainer_MouseEnter" MouseLeave="FeedItemContainer_MouseLeave">
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"></Border>
				</ControlTemplate>
			</Button.Template>
		</Button>
    </Grid>
</UserControl>
