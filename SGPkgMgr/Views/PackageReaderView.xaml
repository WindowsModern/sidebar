<UserControl x:Class="SGPkgMgr.Views.PackageReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SGPkgMgr.Localization">
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock Text="{x:Static loc:Strings.Package}" Margin="0,0,6,0" />
			<TextBox Grid.Column="1" x:Name="txtPackagePath" VerticalAlignment="Center" />
			<ProgressBar Grid.Column="2" x:Name="progress" Width="140" Height="16"
                 VerticalAlignment="Center" Margin="6,0,0,0"
                 Visibility="Collapsed" />
			<Button Grid.Column="3" x:Name="btnBrowse" Content="{x:Static loc:Strings.Browse}"
            Margin="6,0,0,0" Padding="10,2" Click="OnBrowse" />
			<Button Grid.Column="4" x:Name="btnRead" Content="{x:Static loc:Strings.Read}"
            Margin="6,0,0,0" Padding="10,2" Click="OnRead" />
		</Grid>
		<TreeView Grid.Row="1" Margin="0,8,0,0" x:Name="treeReport">
			<TreeView.ContextMenu>
				<ContextMenu>
					<MenuItem Header="{x:Static loc:Strings.CopyNode}" Click="OnCopyNode" />
					<MenuItem Header="{x:Static loc:Strings.CopySubtree}" Click="OnCopySubtree" />
					<MenuItem Header="{x:Static loc:Strings.CopyAll}" Click="OnCopyAll" />
				</ContextMenu>
			</TreeView.ContextMenu>
		</TreeView>
	</Grid>
</UserControl>