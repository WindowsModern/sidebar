<UserControl x:Class="SGPkgMgr.Views.ImportLegacyTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SGPkgMgr.Views"
             xmlns:loc="clr-namespace:SGPkgMgr.Localization">
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- 源文件 -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0"
                       Text="{x:Static loc:Strings.LegacyTileSource}"
                       Margin="0,0,6,0" VerticalAlignment="Center" />
			<TextBox Grid.Column="1" x:Name="txtSource" VerticalAlignment="Center" />
			<Button Grid.Column="2" x:Name="btnBrowse"
                    Content="{x:Static loc:Strings.Browse}"
                    Margin="6,0,0,0" Padding="10,2" Click="OnBrowse" />
			<Button Grid.Column="3" x:Name="btnAnalyze"
                    Content="{x:Static loc:Strings.Analyze}"
                    Margin="6,0,0,0" Padding="10,2" Click="OnAnalyze" />
		</Grid>

		<!-- 状态信息 -->
		<TextBlock Grid.Row="1" x:Name="txtInfo"
                   Margin="0,8,0,6" Foreground="#606060"
                   Text="{x:Static loc:Strings.LegacyTileSourceHint}" />

		<!-- 编辑区：清单 + 文件 -->
		<TabControl Grid.Row="2" x:Name="tabEdit">
			<TabItem Header="{x:Static loc:Strings.Manifest}">
				<views:ManifestEditorView x:Name="manifestEditor" />
			</TabItem>
			<TabItem Header="{x:Static loc:Strings.Files}">
				<views:PackageFilesView x:Name="filesView" />
			</TabItem>
		</TabControl>

		<!-- 进度 + 保存 -->
		<StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,6,0,0">
			<ProgressBar x:Name="progress" Width="220" Height="16"
                         VerticalAlignment="Center" Margin="0,0,10,0"
                         Visibility="Collapsed" />
			<Button x:Name="btnSave" Content="{x:Static loc:Strings.SaveAs}"
                    Padding="20,4" Click="OnSave" />
		</StackPanel>

		<!-- 日志 -->
		<TextBox Grid.Row="4" x:Name="txtLog" Margin="0,8,0,0"
                 IsReadOnly="True" AcceptsReturn="True" Height="140"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
	</Grid>
</UserControl>