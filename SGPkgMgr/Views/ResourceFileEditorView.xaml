<UserControl x:Class="SGPkgMgr.Views.ResourceFileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SGPkgMgr.Views"
             xmlns:loc="clr-namespace:SGPkgMgr.Localization">
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- 第 1 行：文件路径 + 浏览 / 载入 / 保存 / 另存为 -->
		<Grid Grid.Row="0" Margin="0,0,0,6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Column="0"
                       Text="{x:Static loc:Strings.ResourceFile}"
                       Margin="0,0,6,0" VerticalAlignment="Center" />
			<TextBox Grid.Column="1" x:Name="txtPath" VerticalAlignment="Center" />
			<Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}"
                    Margin="6,0,0,0" Padding="10,2" Click="OnBrowse" />
			<Button Grid.Column="3" Content="{x:Static loc:Strings.Load}"
                    Margin="6,0,0,0" Padding="10,2" Click="OnLoad" />
			<Button Grid.Column="4" Content="{x:Static loc:Strings.Save}"
                    Margin="6,0,0,0" Padding="10,2" Click="OnSave" />
			<Button Grid.Column="5" Content="{x:Static loc:Strings.SaveAs}"
                    Margin="6,0,0,0" Padding="10,2" Click="OnSaveAs" />
		</Grid>

		<!-- 第 2 行：新建 + 状态信息 -->
		<Grid Grid.Row="1" Margin="0,0,0,6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Button Grid.Column="0" Content="{x:Static loc:Strings.NewLocaleResource}"
                    Padding="10,2" Click="OnNewLocale" />
			<Button Grid.Column="1" Content="{x:Static loc:Strings.NewPathResource}"
                    Padding="10,2" Margin="6,0,0,0" Click="OnNewPath" />
			<TextBlock Grid.Column="2" x:Name="txtStatus"
                       Foreground="#606060" Margin="12,0,0,0"
                       VerticalAlignment="Center" />
		</Grid>

		<!-- 编辑区 -->
		<TabControl Grid.Row="2" x:Name="tabType"
                    SelectionChanged="OnTabChanged">
			<TabItem x:Name="tabLocale" Header="{x:Static loc:Strings.TabLocaleResources}">
				<views:LocaleResourceEditorView x:Name="localeEditor" />
			</TabItem>
			<TabItem x:Name="tabPath" Header="{x:Static loc:Strings.TabPathResources}">
				<views:PathResourceEditorView x:Name="pathEditor" />
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>