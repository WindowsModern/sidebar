<Window x:Class="SGPkgMgr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SGPkgMgr.Views"
        xmlns:loc="clr-namespace:SGPkgMgr.Localization"
		xmlns:metro="http://schemas.codeplex.com/elysium/theme"
        Title="{x:Static loc:Strings.AppTitle}"
        Height="760" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
	<TabControl Margin="6">
		<TabItem Header="{x:Static loc:Strings.TabManifestEditor}">
			<views:ManifestEditorView />
		</TabItem>
		<TabItem Header="{x:Static loc:Strings.TabPackageReader}">
			<views:PackageReaderView />
		</TabItem>
		<TabItem Header="{x:Static loc:Strings.TabPackageEditor}">
			<views:PackageEditorView />
		</TabItem>
		<TabItem Header="{x:Static loc:Strings.TabSinglePackage}">
			<views:SinglePackageView />
		</TabItem>
		<TabItem Header="{x:Static loc:Strings.TabBundlePackage}">
			<views:BundlePackageView />
		</TabItem>
		<TabItem Header="{x:Static loc:Strings.TabPackageConverter}">
			<views:PackageConverterView />
		</TabItem>
	</TabControl>
</Window>