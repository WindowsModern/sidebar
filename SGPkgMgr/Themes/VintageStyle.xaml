<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

	<!-- 全局字体（多语言回退链） -->
	<FontFamily x:Key="GlobalFontFamily">Microsoft YaHei, Segoe UI, Ebrima, Nirmala, Gadugi, Segoe UI Emoji, Segoe UI Symbol, Meiryo, Leelawadee, Microsoft JhengHei, Malgun Gothic, Estrangelo Edessa, Microsoft Himalaya, Microsoft New Tai Lue, Microsoft PhagsPa, Microsoft Tai Le, Microsoft Yi Baiti, Mongolian Baiti, MV Boli, Myanmar Text, Javanese Text, Cambria Math</FontFamily>

	<!-- 全局字体字号 -->
	<s:Double x:Key="GlobalFontSize">12</s:Double>

	<!-- 窗口底色 -->
	<SolidColorBrush x:Key="VintageWindowBrush" Color="#F0F0F0" />
	<SolidColorBrush x:Key="VintagePanelBrush" Color="#FFFFFF" />
	<SolidColorBrush x:Key="VintageBorderBrush" Color="#A0A0A0" />
	<SolidColorBrush x:Key="VintageTextBrush" Color="#1F1F1F" />

	<!-- 全局控件样式 -->
	<Style TargetType="Control">
		<Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource GlobalFontSize}" />
		<Setter Property="Foreground" Value="{StaticResource VintageTextBrush}" />
	</Style>

	<!-- 全局 TextBlock 样式（截断 + ToolTip） -->
	<Style TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource GlobalFontSize}" />
		<Setter Property="Foreground" Value="{StaticResource VintageTextBrush}" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		<Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<!-- GroupBox -->
	<Style TargetType="GroupBox">
		<Setter Property="Margin" Value="0,0,0,8" />
		<Setter Property="Padding" Value="8,6" />
		<Setter Property="BorderBrush" Value="{StaticResource VintageBorderBrush}" />
		<Setter Property="Background" Value="{StaticResource VintagePanelBrush}" />
		<Setter Property="FontWeight" Value="Normal" />
	</Style>

	<!-- Button -->
	<Style TargetType="Button">
		<Setter Property="Padding" Value="12,4" />
		<Setter Property="Margin" Value="2" />
		<Setter Property="MinWidth" Value="75" />
	</Style>

	<!-- TextBox -->
	<Style TargetType="TextBox">
		<Setter Property="Padding" Value="4,3" />
		<Setter Property="BorderBrush" Value="{StaticResource VintageBorderBrush}" />
		<Setter Property="Background" Value="White" />
	</Style>

	<!-- ComboBox -->
	<Style TargetType="ComboBox">
		<Setter Property="Padding" Value="4,3" />
		<Setter Property="BorderBrush" Value="{StaticResource VintageBorderBrush}" />
	</Style>

	<!-- TabControl / TabItem -->
	<Style TargetType="TabControl">
		<Setter Property="Background" Value="{StaticResource VintagePanelBrush}" />
		<Setter Property="BorderBrush" Value="{StaticResource VintageBorderBrush}" />
		<Setter Property="Padding" Value="6" />
	</Style>
	<Style TargetType="TabItem">
		<Setter Property="Padding" Value="10,6" />
	</Style>

	<!-- 子 TabControl -->
	<Style x:Key="SubTabControl" TargetType="TabControl"
           BasedOn="{StaticResource {x:Type TabControl}}">
		<Setter Property="Margin" Value="0,4,0,0" />
	</Style>

	<!-- TreeView / ListBox 继承全局字体 -->
	<Style TargetType="TreeView">
		<Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource GlobalFontSize}" />
	</Style>
	<Style TargetType="ListBox">
		<Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource GlobalFontSize}" />
	</Style>
	<Style TargetType="DataGrid">
		<Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource GlobalFontSize}" />
	</Style>
</ResourceDictionary>