<UserControl x:Class="ClockTile.SidebarTileContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClockTile"
             mc:Ignorable="d" Width="150"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
		<Control Style="{DynamicResource SidebarBackground}" />
		<Control Style="{DynamicResource TileBackground}"></Control>
		<Control Style="{DynamicResource TileContentBackground}"></Control>
		<Grid Style="{DynamicResource TileContentContainer}">
			<Grid Name="TileContent"></Grid>
		</Grid>
		<Control Style="{DynamicResource TileContentHighlight}" IsHitTestVisible="False"></Control>
		<Control Style="{DynamicResource TileHighlight}" IsHitTestVisible="False"></Control>
		<Control IsHitTestVisible="False" Style="{DynamicResource SidebarHighlightSide}" />
	</Grid>
</UserControl>
