<Window
	x:Class="Sidebar.SidebarWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Sidebar"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pst="clr-namespace:Sidebar.Presentation"
	Title="{pst:StringResource SIDEBAR_TITLE}" Width="150" Height="600" AllowsTransparency="True"
	Background="Transparent" Opacity="1" ResizeMode="NoResize"
	ShowInTaskbar="False" WindowStyle="None" Focusable="False"
	Closed="Window_Closed" Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized" SizeChanged="Window_SizeChanged" MouseDoubleClick="Window_MouseDoubleClick" MouseMove="Window_MouseMove"
	mc:Ignorable="d">
	<Window.Resources>
		<ContextMenu x:Key="SidebarContextMenu">
			<MenuItem Name="MenuItemMinBar" Click="MenuItemMinBar_Click" Header="{pst:StringResource SIDEBAR_CONTEXTMENU_MINBAR}"></MenuItem>
			<MenuItem Name="MenuItemProperties" Click="MenuItemProperties_Click" Header="{pst:StringResource SIDEBAR_CONTEXTMENU_PROP}"></MenuItem>
			<MenuItem Name="MenuItemAddTiles" SubmenuOpened="MenuItemAddTiles_SubmenuOpened" Header="{pst:StringResource SIDEBAR_CONTEXTMENU_ADDTILE}">
				<MenuItem.Items>
					<MenuItem Header="Loading..." IsEnabled="False" />
				</MenuItem.Items>
			</MenuItem>
			<MenuItem Name="MenuItemGetMoreTiles" Click="MenuItemGetMoreTiles_Click" Header="{pst:StringResource SIDEBAR_CONTEXTMENU_STORE}"></MenuItem>
			<Separator />
			<MenuItem Name="MenuItemCancel" Click="MenuItemCancel_Click" Header="{pst:StringResource SIDEBAR_CONTEXTMENU_CANCEL}"></MenuItem>
		</ContextMenu>
		<Storyboard x:Key="ShowTaskbarTiles">
			<DoubleAnimation Storyboard.TargetName="TaskbarTiles" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"></DoubleAnimation>
		</Storyboard>
	</Window.Resources>
	<Grid>
		<Grid Name="SidebarView">
			<Control Style="{DynamicResource SidebarBackground}" />
			<Grid>
				<Button Name="TopOptionsButton" Click="TopOptionsButton_Click" Style="{DynamicResource SidebarOptionsTop}" Focusable="False"/>
				<Control Style="{DynamicResource SidebarOptionsSplliter}" />
				<DockPanel Name="TilesContainer" Style="{DynamicResource SidebarTilesRegion}">
					<ScrollViewer Name="ScrollPinnedTilesControl" Style="{DynamicResource SidebarPinnedTilesScrollControl}" />
					<StackPanel Name="PinnedTilesControl" Style="{DynamicResource SidebarPinnedTilesControl}" />
					<ItemsControl Name="OverflowTilesControl" Style="{DynamicResource SidebarOverflowTilesControl}" pst:ItemsControlAutoCollapseHelper.AutoCollapseWhenEmpty="True"/>
					<ScrollViewer Name="ScrollTilesControl" Style="{DynamicResource SidebarTilesScrollControl}" />
					<StackPanel Name="TilesControl" Style="{DynamicResource SidebarTilesControl}" />
				</DockPanel>
			</Grid>
			<Control IsHitTestVisible="False" Style="{DynamicResource SidebarHighlightSide}" />
		</Grid>
		<Grid Name="TaskbarView" Visibility="Collapsed">
			<Control Style="{DynamicResource SidebarTaskbarTrayBackground}"></Control>
			<StackPanel Orientation="Horizontal">
				<Button Name="RestoreButton" Style="{DynamicResource SidebarMinRestoreButton}" Click="RestoreButton_Click">↑</Button>
				<ItemsControl Name="TaskbarTiles" Style="{DynamicResource SidebarMinTaskbarTilesControl}"></ItemsControl>
			</StackPanel>
		</Grid>
	</Grid>
</Window>