	<Style x:Key="NotificationTextAreaInnerBorder" TargetType="Border">
		<Setter Property="BorderBrush">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Offset="0" Color="#5554585A" />
					<GradientStop Offset="0.25" Color="#55D0D8DA" />
					<GradientStop Offset="0.5" Color="#00FFFFFF" />
					<GradientStop Offset="0.75" Color="#55D0D8DA" />
					<GradientStop Offset="1" Color="#5554585A" />
				</LinearGradientBrush>
