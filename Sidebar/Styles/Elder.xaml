<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
	xmlns:snt="clr-namespace:Sidebar;assembly=Native"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:pres="clr-namespace:Sidebar.Presentation"
                    xmlns:local="clr-namespace:Sidebar">
	<!--  Sidebar  -->
	<Style x:Key="SidebarBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid>
						<Control Style="{DynamicResource SidebarBackgroundTemplate}" Tag="{Binding OpaqueThemeBrush, Source={x:Static pres:DwmThemeProvider.Instance}}" />
						<Rectangle Name="Background" Style="{DynamicResource Background}" />
						<snt:Slice9Image Name="BackgroundImage1" Style="{DynamicResource BackgroundImageSlice9}" />
						<Image Name="BackgroundImage" Style="{DynamicResource BackgroundImage}" />
						<Rectangle Name="BackgroundHighlight" Style="{DynamicResource BackgroundHighlight}" />
						<Canvas Name="BackgroundCustom" Style="{DynamicResource BackgroundCustomDraw}" />
						<Grid>
							<Line
												x:Name="BorderLine"
												Style="{DynamicResource BorderLine}"
												X1="0"
												X2="0"
												Y1="0"
												Y2="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="Background" TargetType="Rectangle">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Fill" Value="{Binding ThemeBrush, Source={x:Static pres:DwmThemeProvider.Instance}}" />
	</Style>
	<Style x:Key="BackgroundImage" TargetType="Image">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Stretch" Value="Fill" />
		<Setter Property="Source" Value="{x:Null}" />
	</Style>
	<Style x:Key="BackgroundHighlight" TargetType="Rectangle">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Fill" Value="Transparent" />
	</Style>
	<Style x:Key="BorderLine" TargetType="Line">
		<Setter Property="Stroke" Value="#53000000" />
		<Setter Property="StrokeThickness" Value="1" />
	</Style>
	<Style x:Key="BackgroundCustomDraw" TargetType="Canvas">
		<Setter Property="Visibility" Value="Collapsed" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
	</Style>
	<Style x:Key="SidebarBackgroundTemplate" TargetType="Control">
		<Setter Property="Visibility" Value="Collapsed" />
	</Style>
	<Style x:Key="TileSplitterPanel" TargetType="StackPanel">
		<Setter Property="DockPanel.Dock" Value="Bottom" />
		<Setter Property="Height" Value="4" />
		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="Background" Value="#00000000" />
	</Style>
	<Style x:Key="TileSplitterLineTop" TargetType="Line">
		<Setter Property="Opacity" Value="0" />
	</Style>
	<Style x:Key="TileSplitterLineBottom" TargetType="Line">
		<Setter Property="Opacity" Value="1" />
		<Setter Property="X1" Value="0" />
		<Setter Property="X2" Value="200" />
		<Setter Property="Stretch" Value="UniformToFill" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Stroke" Value="#53000000" />
	</Style>
	<Style x:Key="TileSplitterTopBlankFill" TargetType="Rectangle">
		<Setter Property="Height" Value="0" />
	</Style>
	<Style x:Key="TileSplitterBottomBlankFill" TargetType="Rectangle">
		<Setter Property="Height" Value="0" />
	</Style>
	<Style x:Key="TileSplitterLineTopLighting" TargetType="Line">
		<Setter Property="Opacity" Value="0" />
	</Style>
	<Style x:Key="TileSplitterLineBottomLighting" TargetType="Line">
		<Setter Property="Opacity" Value="1" />
		<Setter Property="X1" Value="0" />
		<Setter Property="X2" Value="200" />
		<Setter Property="Stretch" Value="UniformToFill" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Stroke" Value="#53FFFFFF" />
	</Style>
	<Style
						x:Key="TileSplitterTopBlankFillLighting"
						BasedOn="{StaticResource TileSplitterTopBlankFill}"
						TargetType="Rectangle" />
	<Style
						x:Key="TileSplitterBottomBlankFillLighting"
						BasedOn="{StaticResource TileSplitterBottomBlankFill}"
						TargetType="Rectangle" />
	<Style x:Key="TopOptionsPanelSplitter" TargetType="StackPanel">
		<Setter Property="Margin" Value="0,17,0,0" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Cursor" Value="Arrow" />
		<Setter Property="Background" Value="#00000000" />
		<Setter Property="Height" Value="4" />
	</Style>
	<Style x:Key="MainPanel" TargetType="DockPanel">
		<Setter Property="Margin" Value="0,19,0,0" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="LastChildFill" Value="True" />
	</Style>
	<Style x:Key="PinnedTilesRegion" TargetType="StackPanel">
		<Setter Property="DockPanel.Dock" Value="Bottom" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Top" />
	</Style>
	<Style x:Key="TilesRegion" TargetType="StackPanel">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
	</Style>
	<Style x:Key="SidebarHighlight" TargetType="Rectangle">
		<Setter Property="Stretch" Value="Fill" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="Width" Value="8" />
		<Setter Property="Visibility" Value="Hidden" />
	</Style>
	<Style x:Key="BackgroundImageSlice9" TargetType="snt:Slice9Image">
		<Setter Property="Visibility" Value="Collapsed" />
	</Style>

	<!--  Top Options  -->
	<Style x:Key="TopOptionsText" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource GlobalForegroundBrush}" />
		<Setter Property="FontSize" Value="{DynamicResource GlobalNormalFontSize}" />
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
	</Style>
	<Style x:Key="TopOptionsIcon" TargetType="Polygon">
		<Setter Property="Opacity" Value="0.45" />
		<Setter Property="Stroke" Value="#020202" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Fill" Value="White" />
		<Setter Property="Margin" Value="2,1,2,0" />
		<Setter Property="RenderTransformOrigin" Value="0.556,0.9" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="StrokeStartLineCap" Value="Round" />
		<Setter Property="StrokeEndLineCap" Value="Round" />
		<Setter Property="StrokeLineJoin" Value="Round" />
	</Style>

	<!--  Tile  -->
	<Style x:Key="TilePanel" TargetType="DockPanel">
		<Setter Property="Background" Value="#00000000" />
	</Style>
	<Style x:Key="TileHeader" TargetType="DockPanel">
		<Setter Property="Visibility" Value="Visible" />
		<Setter Property="DockPanel.Dock" Value="Top" />
		<Setter Property="Height" Value="20" />
		<Setter Property="Background" Value="#00000000" />
	</Style>
	<Style x:Key="TileIcon" TargetType="Image">
		<Setter Property="DockPanel.Dock" Value="Right" />
		<Setter Property="Height" Value="15" />
		<Setter Property="Width" Value="15" />
		<Setter Property="Source" Value="Images\default.ico" />
	</Style>
	<Style x:Key="TileTitle" TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="Margin" Value="5,0,5,0" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="Foreground" Value="{DynamicResource GlobalForegroundBrush}" />
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
	</Style>
	<Style x:Key="TileContent" TargetType="Grid">
		<Setter Property="Background" Value="#00000000" />
		<Setter Property="Margin" Value="1,0,0,0" />
	</Style>
	<Style x:Key="TileFlyoutIcon" TargetType="Polygon">
		<Setter Property="Opacity" Value="0" />
		<Setter Property="Stroke" Value="#020202" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Fill" Value="White" />
		<Setter Property="Margin" Value="1,2,1,0" />
		<Setter Property="RenderTransformOrigin" Value="0.556,0.9" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="StrokeStartLineCap" Value="Round" />
		<Setter Property="StrokeEndLineCap" Value="Round" />
		<Setter Property="StrokeLineJoin" Value="Round" />
	</Style>
	<Style
						x:Key="PinnedTileIcon"
						BasedOn="{StaticResource TileIcon}"
						TargetType="Image" />
	<Style
						x:Key="PinnedTileTitle"
						BasedOn="{StaticResource TileTitle}"
						TargetType="TextBlock" />
	<Style x:Key="PinnedTileHeader" TargetType="DockPanel">
		<Setter Property="Visibility" Value="Collapsed" />
	</Style>
	<Style
						x:Key="PinnedTileFlyoutIcon"
						BasedOn="{StaticResource TileFlyoutIcon}"
						TargetType="Polygon">
		<Setter Property="Margin" Value="1,4,1,0" />
	</Style>
	<Style
						x:Key="PinnedTileContent"
						BasedOn="{StaticResource TileContent}"
						TargetType="Grid">
		<!-- <Setter Property="Margin" Value="0,0,1,0" /> -->
	</Style>
	<Style
						x:Key="PinnedTileSplitterPanel"
						BasedOn="{StaticResource TileSplitterPanel}"
						TargetType="StackPanel">
		<Setter Property="DockPanel.Dock" Value="Top" />
	</Style>

	<!--  Flyout  -->
	<Style x:Key="FlyoutBorder" TargetType="Rectangle">
		<Setter Property="Stroke" Value="#53000000" />
		<Setter Property="StrokeThickness" Value="1" />
	</Style>
	<Style x:Key="FlyoutBackgroundFill" TargetType="Rectangle">
		<Setter Property="Fill" Value="{Binding ThemeBrush, Source={x:Static pres:DwmThemeProvider.Instance}}" />
	</Style>
	<Style
						x:Key="FlyoutHeaderOptionsIcon"
						BasedOn="{StaticResource TopOptionsIcon}"
						TargetType="Polygon">
		<Setter Property="Margin" Value="2,0,0,0" />
	</Style>
	<Style x:Key="FlyoutContent" TargetType="Grid">
		<Setter Property="Margin" Value="4,17,4,4" />
	</Style>
	<Style x:Key="FlyoutBackgroundImageSlice9" TargetType="snt:Slice9Image">
		<Setter Property="Visibility" Value="Collapsed" />
	</Style>

	<!--  Drag  -->
	<Style x:Key="DragWindowStyle" TargetType="Window">
		<Setter Property="Opacity" Value="0.8" />
	</Style>
	<Style x:Key="DragPlaceholder" TargetType="Rectangle">
		<Setter Property="Margin" Value="0,0,0,0" />
		<Setter Property="Stroke" Value="#59FFFFFF" />
		<Setter Property="StrokeThickness" Value="2" />
		<Setter Property="Opacity" Value="1" />
		<Setter Property="Fill" Value="#33FFFFFF" />
		<Setter Property="RenderTransform">
			<Setter.Value>
				<ScaleTransform ScaleX="1" ScaleY="1" />
			</Setter.Value>
		</Setter>
		<Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
		<Style.Triggers>
			<EventTrigger RoutedEvent="Rectangle.Loaded">
				<BeginStoryboard>
					<Storyboard Duration="0:0:0.2">
						<DoubleAnimation
											Storyboard.TargetProperty="Opacity"
											From="1"
											To="0.6" />
						<DoubleAnimation
											Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
											From="1"
											To="0.4" />
						<DoubleAnimation
											Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
											From="1"
											To="0.4" />
					</Storyboard>
				</BeginStoryboard>
			</EventTrigger>
		</Style.Triggers>
	</Style>

	<!--  Notification  -->
	<Style x:Key="NotificationWindow" TargetType="Window">
		<Setter Property="MinWidth" Value="152" />
		<Setter Property="MinHeight" Value="67" />
		<Setter Property="MaxWidth" Value="354" />
		<Setter Property="MaxHeight" Value="275" />
	</Style>
	<Style x:Key="NotificationRegionBorder" TargetType="Border">
		<Setter Property="CornerRadius" Value="5" />
		<Setter Property="ClipToBounds" Value="True" />
		<Setter Property="Margin" Value="0,0,9,10" />
	</Style>
	<Style x:Key="NotificationBaseBackground" TargetType="Border">
		<Setter Property="Background" Value="#070707" />
		<Setter Property="Background" Value="#20FFFFFF" />
		<!-- <Setter Property="Background" Value="{Binding ThemeBrush, Source={x:Static pres:DwmThemeProvider.Instance}}" /> -->
		<Setter Property="CornerRadius" Value="5" />
	</Style>
	<Style x:Key="NotificationBackgroundImageSlice9" TargetType="snt:Slice9Image">
		<Setter Property="Visibility" Value="Collapsed" />
	</Style>
	<Style x:Key="NotificationBackgroundHighlight" TargetType="Border">
		<Setter Property="CornerRadius" Value="5" />
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Offset="0" Color="#7EFFFFFF" />
					<GradientStop Offset="0.5" Color="#00FFFFFF" />
					<GradientStop Offset="0.95" Color="#00FFFFFF" />
					<GradientStop Offset="1" Color="#7EFFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter Property="OpacityMask">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="#FFFFFFFF" />
					<GradientStop Offset="1" Color="#00FFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="NotificationBorder" TargetType="Border">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="5" />
		<Setter Property="BorderBrush" Value="#61676F" />
		<Setter Property="Margin" Value="0,15,0,0" />
	</Style>
	<Style x:Key="NotificationHeader" TargetType="StackPanel">
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Margin" Value="0,2,7,0" />
		<Setter Property="Height" Value="14" />
	</Style>
	<Style x:Key="NotificationOptionsButton" TargetType="Button">
		<Setter Property="Width" Value="Auto" />
		<Setter Property="Height" Value="Auto" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<TextBlock
    x:Name="PART_TextBlock"
    FontFamily="{DynamicResource GlobalFontFamily}"
    FontSize="10"
    Foreground="Black"
    Text="{pres:StringResource SIDEBAR_OPTIONS}">
						<TextBlock.Effect>
							<DropShadowEffect
												x:Name="PART_Glow"
												BlurRadius="6"
												Opacity="0.6"
												ShadowDepth="0"
												Color="White" />
						</TextBlock.Effect>
					</TextBlock>
					<ControlTemplate.Triggers>
						<EventTrigger RoutedEvent="MouseEnter">
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation
														Storyboard.TargetName="PART_Glow"
														Storyboard.TargetProperty="BlurRadius"
														To="14"
														Duration="0:0:0.15" />
									<DoubleAnimation
														Storyboard.TargetName="PART_Glow"
														Storyboard.TargetProperty="Opacity"
														To="1"
														Duration="0:0:0.15" />
								</Storyboard>
							</BeginStoryboard>
						</EventTrigger>
						<EventTrigger RoutedEvent="MouseLeave">
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation
														Storyboard.TargetName="PART_Glow"
														Storyboard.TargetProperty="BlurRadius"
														To="6"
														Duration="0:0:0.15" />
									<DoubleAnimation
														Storyboard.TargetName="PART_Glow"
														Storyboard.TargetProperty="Opacity"
														To="0.6"
														Duration="0:0:0.15" />
								</Storyboard>
							</BeginStoryboard>
						</EventTrigger>
						<EventTrigger RoutedEvent="TouchEnter">
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation
														Storyboard.TargetName="PART_Glow"
														Storyboard.TargetProperty="BlurRadius"
														To="14"
														Duration="0:0:0.15" />
									<DoubleAnimation
														Storyboard.TargetName="PART_Glow"
														Storyboard.TargetProperty="Opacity"
														To="1"
														Duration="0:0:0.15" />
								</Storyboard>
							</BeginStoryboard>
						</EventTrigger>
						<EventTrigger RoutedEvent="TouchLeave">
							<BeginStoryboard>
								<Storyboard>
									<DoubleAnimation
														Storyboard.TargetName="PART_Glow"
														Storyboard.TargetProperty="BlurRadius"
														To="6"
														Duration="0:0:0.15" />
									<DoubleAnimation
														Storyboard.TargetName="PART_Glow"
														Storyboard.TargetProperty="Opacity"
														To="0.6"
														Duration="0:0:0.15" />
								</Storyboard>
							</BeginStoryboard>
						</EventTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="NotificationCloseButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid>
						<Image x:Name="Normal" Source="Images\Notification\CloseNormal.png" />
						<Image
											x:Name="Hover"
											Opacity="0"
											Source="Images\Notification\CloseLight.png" />
						<Image
											x:Name="Active"
											Opacity="0"
											Source="Images\Notification\ClosePress.png" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
															Storyboard.TargetName="Hover"
															Storyboard.TargetProperty="Opacity"
															To="1"
															Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
															Storyboard.TargetName="Hover"
															Storyboard.TargetProperty="Opacity"
															To="0"
															Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
															Storyboard.TargetName="Active"
															Storyboard.TargetProperty="Opacity"
															To="1"
															Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
															Storyboard.TargetName="Active"
															Storyboard.TargetProperty="Opacity"
															To="0"
															Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Margin" Value="5,0,0,0" />
	</Style>
	<Style x:Key="NotificationIcon" TargetType="Image">
		<Setter Property="Width" Value="16" />
		<Setter Property="Height" Value="16" />
		<Setter Property="Margin" Value="4,21,0,0" />
