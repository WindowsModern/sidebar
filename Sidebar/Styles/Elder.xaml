	<Style x:Key="NotificationTextAreaTextPart" TargetType="Border">
		<Setter Property="BorderBrush" Value="#05FFFFFF" />
		<Setter Property="CornerRadius" Value="2" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style x:Key="NotificationTextAreaBackgroundImageSlice9" TargetType="snt:Slice9Image">
		<Setter Property="Visibility" Value="Collapsed" />
	</Style>
	<Style x:Key="NotificationTimeout" TargetType="Control">
		<Setter Property="Background" Value="#B2FF8B25" />
		<Setter Property="Margin" Value="0,-3,0,0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Rectangle
										Fill="{TemplateBinding Background}"
										Opacity="{TemplateBinding Opacity}"
										OpacityMask="{TemplateBinding OpacityMask}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Width" Value="5" />
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Margin" Value="0,-10,1,0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<DockPanel>
						<Border
											Height="10"
											Background="{TemplateBinding Background}"
											DockPanel.Dock="Top">
							<Border.OpacityMask>
