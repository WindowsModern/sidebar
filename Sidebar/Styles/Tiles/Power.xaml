		<GradientStop Color="#333333" Offset="0"/>
		<GradientStop Color="#babaa3" Offset="0.5"/>
		<GradientStop Color="#333333" Offset="1"/>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="TilePowerTileShinyGreen" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#4fdf26" Offset="0"/>
		<GradientStop Color="#a1fe86" Offset="0.3"/>
		<GradientStop Color="#4bde21" Offset="1"/>
