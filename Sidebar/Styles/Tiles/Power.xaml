		<GradientStop Color="#fff799" Offset="0.5"/>
		<GradientStop Color="#fff200" Offset="1"/>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="TilePowerTileShinyRed" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#d71b0c" Offset="0"/>
		<GradientStop Color="#f0c3bf" Offset="0.5"/>
		<GradientStop Color="#d71b0c" Offset="1"/>
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="TilePowerTileGraySweep" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Color="#000000" Offset="0"/>
		<GradientStop Color="#777777" Offset="0.8"/>
		<GradientStop Color="#888888" Offset="1"/>
	</LinearGradientBrush>
