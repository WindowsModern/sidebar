<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Sidebar">
	<!--  Slideshow:Flyout  -->
	<Style x:Key="TileSlideshowBackButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Image x:Name="img" Source="..\..\Images\Slideshow\back_normal.png" Stretch="None" />
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="img" Property="Source" Value="..\..\Images\Slideshow\back_hover.png" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="img" Property="Source" Value="..\..\Images\Slideshow\back_hover.png" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="img" Property="Opacity" Value="0.6" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="TileSlideshowNextButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Image x:Name="img" Source="..\..\Images\Slideshow\next_normal.png" Stretch="None" />
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="img" Property="Source" Value="..\..\Images\Slideshow\next_hover.png" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="img" Property="Source" Value="..\..\Images\Slideshow\next_hover.png" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="img" Property="Opacity" Value="0.6" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="TileSlideshowOpenFileButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Image x:Name="img" Source="..\..\Images\Slideshow\file_normal.png" Stretch="None" />
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="img" Property="Source" Value="..\..\Images\Slideshow\file_hover.png" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="img" Property="Source" Value="..\..\Images\Slideshow\file_hover.png" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="img" Property="Opacity" Value="0.6" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="TileSlideshowFlyoutFileName" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
		<Setter Property="Foreground" Value="{DynamicResource GlobalForegroundBrush}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Margin" Value="5,3,5,7" />
	</Style>
</ResourceDictionary>