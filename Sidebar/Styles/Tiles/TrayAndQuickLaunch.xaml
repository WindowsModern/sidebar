		<Setter Property="Height" Value="28" />
		<Setter Property="Width" Value="28"></Setter>
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Padding" Value="4,4,4,4" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template" Value="{DynamicResource TileIconItemTemplate}"></Setter>
	</Style>
	<ItemsPanelTemplate x:Key="TileIconItemWrapPanelForQuickLaunchTile">
		<WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" />
	</ItemsPanelTemplate>
	<Style x:Key="TileIconItemTileContainerForQuickLaunchTile" TargetType="ItemsControl">
