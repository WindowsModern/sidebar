		<Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
	</Style>
	<Style x:Key="TileIconItemWithTextForTrayTile" TargetType="Button">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Height" Value="Auto" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Padding" Value="4,4,4,4" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template" Value="{DynamicResource TileIconItemWithTextTemplate}"></Setter>
	</Style>
	<ItemsPanelTemplate x:Key="TileIconItemWithTextWrapPanelForTrayTile">
		<WrapPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" Orientation="Vertical" />
	</ItemsPanelTemplate>

