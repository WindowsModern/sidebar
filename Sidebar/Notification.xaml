<Window x:Class="Sidebar.Notification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:nt="clr-namespace:Sidebar;assembly=Native"
        xmlns:local="clr-namespace:Sidebar"
		x:Name="Root"
        mc:Ignorable="d" ResizeMode="NoResize" WindowStyle="None" Background="{x:Null}" SnapsToDevicePixels="True"
		AllowsTransparency="True" UseLayoutRounding="True"
		Style="{DynamicResource NotificationWindow}" Topmost="True" ShowInTaskbar="False"
        Title="Notification" Height="98" Width="267" SizeToContent="WidthAndHeight"
		Loaded="Root_Loaded" Unloaded="Root_Unloaded" SizeChanged="Root_SizeChanged" 
		Closed="Root_Closed" SourceInitialized="Root_SourceInitialized"
		MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave" TouchEnter="Root_TouchEnter" TouchLeave="Root_TouchLeave">
	<Window.Resources>
		<ContextMenu x:Key="NotificationOptionsMenu">
			<MenuItem Name="ItemOpenCtrlRule" Header="{Binding Source='SIDEBAR_NOTIFY_RULES', Converter={x:Static local:StringResourceConverter.Instance}}" Click="ItemOpenCtrlRule_Click"></MenuItem>
		</ContextMenu>
	</Window.Resources>
	<Window.Triggers>
		<EventTrigger RoutedEvent="UIElement.MouseEnter" SourceName="Root">
			<BeginStoryboard Storyboard="{DynamicResource NotificationEnter}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="UIElement.MouseLeave" SourceName="Root">
			<BeginStoryboard Storyboard="{DynamicResource NotificationLeave}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="UIElement.TouchEnter" SourceName="Root">
			<BeginStoryboard Storyboard="{DynamicResource NotificationEnter}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="UIElement.TouchLeave" SourceName="Root">
			<BeginStoryboard Storyboard="{DynamicResource NotificationLeave}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="Loaded" SourceName="Root">
			<BeginStoryboard Storyboard="{DynamicResource NotificationLoaded}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="Unloaded" SourceName="Root">
			<BeginStoryboard Storyboard="{DynamicResource NotificationUnloaded}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="UIElement.MouseEnter" SourceName="TextAreaTextArea">
			<BeginStoryboard Storyboard="{DynamicResource NotificationContentEnter}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="UIElement.MouseLeave" SourceName="TextAreaTextArea">
			<BeginStoryboard Storyboard="{DynamicResource NotificationContentLeave}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="UIElement.TouchEnter" SourceName="TextAreaTextArea">
			<BeginStoryboard Storyboard="{DynamicResource NotificationContentEnter}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="UIElement.TouchLeave" SourceName="TextAreaTextArea">
			<BeginStoryboard Storyboard="{DynamicResource NotificationContentLeave}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="Loaded" SourceName="TextAreaTextArea">
			<BeginStoryboard Storyboard="{DynamicResource NotificationContentLoaded}"></BeginStoryboard>
		</EventTrigger>
	</Window.Triggers>
	<Grid>
		<Border Name="NotificationUI" Style="{DynamicResource NotificationRegionBorder}">
			<Grid>
				<Grid Name="BackgroundContainer" SizeChanged="BackgroundContainer_SizeChanged" Style="{DynamicResource NotificationBackgroundContainer}">
					<Grid Name="BackgroundHeightChange" SizeChanged="BackgroundContainer_SizeChanged" Visibility="Hidden" Style="{DynamicResource NotificationHeightClipContainer}"></Grid>
					<Grid>
						<Border Name="BackgroundBase" Style="{DynamicResource NotificationBaseBackground}"></Border>
						<Border Name="BackgroundHighlight" Style="{DynamicResource NotificationBackgroundHighlight}"></Border>
						<nt:Slice9Image Name="BackgroundHighlightImage" Style="{DynamicResource NotificationBackgroundImageSlice9}"></nt:Slice9Image>
						<Border Name="BackgroundBorder" Style="{DynamicResource NotificationBorder}"></Border>
						<StackPanel Name="HeaderBar" Style="{DynamicResource NotificationHeader}" Opacity="0">
							<Button Name="OptionsButton" Style="{DynamicResource NotificationOptionsButton}" Content="{Binding Source='SIDEBAR_NOTIFY_OPTIONS', Converter={x:Static local:StringResourceConverter.Instance}}" Click="OptionsButton_Click" ContextMenu="{DynamicResource NotificationOptionsMenu}"></Button>
							<Button Name="CloseButton" Click="CloseButton_Click" Style="{DynamicResource NotificationCloseButton}"></Button>
						</StackPanel>
						<Control Name="TimeoutBar" Style="{DynamicResource NotificationTimeout}"></Control>
					</Grid>
					<Grid Name="IconPart" Style="{DynamicResource NotificationIconPart}">
						<Image Name="Icon" Source="Images\default.ico" Style="{DynamicResource NotificationIcon}">
							<Image.RenderTransform>
								<TranslateTransform x:Name="IconTranslate" Y="0" />
							</Image.RenderTransform>
						</Image>
						<Image Name="IconRef" Source="Images\default.ico" Style="{DynamicResource NotificationIconReflection}">
							<Image.RenderTransform>
								<TranslateTransform x:Name="IconRefTranslate" Y="0" />
							</Image.RenderTransform>
						</Image>
					</Grid>
				</Grid>
				<nt:Slice9Image Name="TextAreaBackgroundImage" Style="{DynamicResource NotificationTextAreaBackgroundImageSlice9}"></nt:Slice9Image>
				<Border Name="TextAreaBorderOuter" Style="{DynamicResource NotificationTextAreaOuterBorder}">
					<Border Name="TextAreaBorderInner" Style="{DynamicResource NotificationTextAreaInnerBorder}">
						<Border Name="TextAreaTextArea" Style="{DynamicResource NotificationTextAreaTextPart}">
							<ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Style="{DynamicResource AutoHideScrollViewer}">
								<StackPanel MouseDown="ScrollViewer_MouseDown" MouseUp="ScrollViewer_MouseUp" TouchDown="ScrollViewer_TouchDown" TouchUp="ScrollViewer_TouchUp">
									<TextBlock Name="MessageTitle" TextWrapping="Wrap" Style="{DynamicResource NotificationTitle}" HorizontalAlignment="Left">Stay current with automatic updates</TextBlock>
									<TextBlock Name="MessageContent" TextWrapping="Wrap" Style="{DynamicResource NotificationContent}">Click here to learn how to keep your computer up to date automatically with important downloads from Windows Update.</TextBlock>
								</StackPanel>
							</ScrollViewer>
						</Border>
					</Border>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>
