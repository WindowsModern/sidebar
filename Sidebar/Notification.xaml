<Window x:Class="Sidebar.Notification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:nt="clr-namespace:Sidebar;assembly=Native"
        xmlns:local="clr-namespace:Sidebar"
		x:Name="Root"
        mc:Ignorable="d" ResizeMode="NoResize" WindowStyle="None" Background="{x:Null}" SnapsToDevicePixels="True"
		AllowsTransparency="True" UseLayoutRounding="True"
		Style="{DynamicResource NotificationWindow}" Topmost="True" ShowInTaskbar="False"
        Title="Notification" Height="98" Width="267" SizeToContent="WidthAndHeight"
		Loaded="Root_Loaded" Unloaded="Root_Unloaded" SizeChanged="Root_SizeChanged" Closed="Root_Closed" SourceInitialized="Root_SourceInitialized">
	<Window.Resources>
		<Style x:Key="NotificationWindow" TargetType="Window">
			<Setter Property="MinWidth" Value="152"></Setter>
			<Setter Property="MinHeight" Value="67"></Setter>
			<Setter Property="MaxWidth" Value="354"></Setter>
			<Setter Property="MaxHeight" Value="275"></Setter>
		</Style>
		<Style x:Key="NotificationRegionBorder" TargetType="Border">
			<Setter Property="CornerRadius" Value="5"></Setter>
			<Setter Property="ClipToBounds" Value="True"></Setter>
			<Setter Property="Margin" Value="0,0,9,10"></Setter>
		</Style>
		<Style x:Key="NotificationBaseBackground" TargetType="Border">
			<Setter Property="Background" Value="#070707"></Setter>
			<Setter Property="CornerRadius" Value="5"></Setter>
		</Style>
		<Style x:Key="NotificationBackgroundImageSlice9" TargetType="nt:Slice9Image">
			<Setter Property="Source" Value="Images\Notification\NotificationHighlight.png"></Setter>
			<Setter Property="SliceThickness" Value="7,6"></Setter>
		</Style>
		<Style x:Key="NotificationBackgroundHighlight" TargetType="Border">
			<Setter Property="Visibility" Value="Collapsed"></Setter>
			<Setter Property="CornerRadius" Value="5"></Setter>
			<Setter Property="Background">
				<Setter.Value>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#7EFFFFFF" Offset="0"></GradientStop>
						<GradientStop Color="#00FFFFFF" Offset="0.5"></GradientStop>
						<GradientStop Color="#00FFFFFF" Offset="0.95"></GradientStop>
						<GradientStop Color="#7EFFFFFF" Offset="1"></GradientStop>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter>
			<Setter Property="OpacityMask">
				<Setter.Value>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Color="#FFFFFFFF" Offset="0"></GradientStop>
						<GradientStop Color="#00FFFFFF" Offset="1"></GradientStop>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="NotificationBorder" TargetType="Border">
			<Setter Property="Visibility" Value="Collapsed"></Setter>
			<Setter Property="Background" Value="Transparent"></Setter>
			<Setter Property="BorderThickness" Value="1"></Setter>
			<Setter Property="CornerRadius" Value="5"></Setter>
			<Setter Property="BorderBrush" Value="#61676F"></Setter>
		</Style>
		<Style x:Key="NotificationHeader" TargetType="StackPanel">
			<Setter Property="Orientation" Value="Horizontal"></Setter>
			<Setter Property="HorizontalAlignment" Value="Right"></Setter>
			<Setter Property="VerticalAlignment" Value="Top"></Setter>
			<Setter Property="Margin" Value="0,1,5,0"></Setter>
			<Setter Property="Height" Value="14"></Setter>
		</Style>
		<Style x:Key="NotificationOptionsButton" TargetType="Button">
			<Setter Property="Width" Value="Auto"></Setter>
			<Setter Property="Height" Value="Auto"></Setter>
			<Setter Property="VerticalAlignment" Value="Center"></Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate>
						<TextBlock Foreground="White" FontSize="10" FontFamily="{DynamicResource GlobalFontFamily}" Text="{Binding Source='SIDEBAR_OPTIONS', Converter={x:Static local:StringResourceConverter.Instance}}"></TextBlock>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="NotificationCloseButton" TargetType="Button">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate>
						<nt:ImageButton NormalSource="Images\Notification\CloseNormal.png"
										HoverSource="Images\Notification\CloseLight.png"
										ActiveSource="Images\Notification\ClosePress.png"
										UseAnimation="True"
										></nt:ImageButton>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="NotificationIcon" TargetType="Image">
			<Setter Property="Width" Value="16"></Setter>
			<Setter Property="Height" Value="16"></Setter>
			<Setter Property="Margin" Value="0,21,0,0"></Setter>
			<Setter Property="HorizontalAlignment" Value="Left"></Setter>
			<Setter Property="VerticalAlignment" Value="Top"></Setter>
		</Style>
		<Style x:Key="NotificationIconReflection" TargetType="Image">
			<Setter Property="Width" Value="16"></Setter>
			<Setter Property="Height" Value="16"></Setter>
			<Setter Property="Margin" Value="0,53,0,0"></Setter>
			<Setter Property="HorizontalAlignment" Value="Left"></Setter>
			<Setter Property="VerticalAlignment" Value="Top"></Setter>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<ScaleTransform ScaleY="-1" />
				</Setter.Value>
			</Setter>
			<Setter Property="Opacity" Value="0.44"></Setter>
			<Setter Property="Visibility" Value="Collapsed"></Setter>
		</Style>
		<Style x:Key="NotificationTextAreaOuterBorder" TargetType="Border">
			<Setter Property="BorderBrush">
				<Setter.Value>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#80BABEC0" Offset="0"></GradientStop>
						<GradientStop Color="#00FFFFFF" Offset="0.5"></GradientStop>
						<GradientStop Color="#80BABEC0" Offset="1"></GradientStop>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter>
			<Setter Property="Margin" Value="16,15,5,0"></Setter>
			<Setter Property="CornerRadius" Value="4"></Setter>
			<Setter Property="BorderThickness" Value="0"></Setter>
		</Style>
		<Style x:Key="NotificationTextAreaInnerBorder" TargetType="Border">
			<Setter Property="BorderBrush">
				<Setter.Value>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#8054585A" Offset="0"></GradientStop>
						<GradientStop Color="#80D0D8DA" Offset="0.25"></GradientStop>
						<GradientStop Color="#00FFFFFF" Offset="0.5"></GradientStop>
						<GradientStop Color="#80D0D8DA" Offset="0.75"></GradientStop>
						<GradientStop Color="#8054585A" Offset="1"></GradientStop>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter>
			<Setter Property="CornerRadius" Value="3"></Setter>
			<Setter Property="BorderThickness" Value="0"></Setter>
		</Style>
		<Style x:Key="NotificationTextAreaTextPart" TargetType="Border">
			<!-- 
			<Setter Property="BorderBrush" Value="White"></Setter>
			<Setter Property="CornerRadius" Value="2"></Setter>
			<Setter Property="BorderThickness" Value="1"></Setter>
			<Setter Property="Background" Value="#F4F4F4"></Setter>
			-->
			<Setter Property="Margin" Value="3"></Setter>
			<Setter Property="Cursor" Value="Hand"></Setter>
		</Style>
		<Style x:Key="NotificationTextAreaBackgroundImageSlice9" TargetType="nt:Slice9Image">
			<Setter Property="Margin" Value="16,15,5,0"></Setter>
			<Setter Property="Source" Value="Images\Notification\TextBlock.png"></Setter>
			<Setter Property="SliceThickness" Value="7"></Setter>
		</Style>
		<Style x:Key="NotificationTimeout" TargetType="Control">
			<!-- 
			<Setter Property="Background" Value="#DD7D2F"></Setter>
			<Setter Property="OpacityMask">
				<Setter.Value>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Color="#00FFFFFF" Offset="0.0"/>
						<GradientStop Color="#FFFFFFFF" Offset="0.01"/>
						<GradientStop Color="#FFFFFFFF" Offset="1.0"/>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter> 
			<Setter Property="Margin" Value="0,-3,0,0"></Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Control">
						<Rectangle Fill="{TemplateBinding Background}"
								   Opacity="{TemplateBinding Opacity}"
								   OpacityMask="{TemplateBinding OpacityMask}"></Rectangle>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			-->
			<Setter Property="Width" Value="5"></Setter>
			<Setter Property="HorizontalAlignment" Value="Right"></Setter>
			<Setter Property="VerticalAlignment" Value="Stretch"></Setter>
			<Setter Property="Margin" Value="0,-10,0,0"></Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate>
						<nt:Slice9Image Source="Images\Notification\NotificationTimeout.png" SliceThickness="0,10,0,0"></nt:Slice9Image>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="NotificationHeightClipContainer" TargetType="Grid">
			<Setter Property="Width" Value="0"></Setter>
			<Setter Property="Height" Value="15"></Setter>
			<Setter Property="Tag" Value="5"></Setter>
		</Style>
		<Style x:Key="NotificationTitle" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"></Setter>
			<Setter Property="FontSize" Value="14"></Setter>
			<Setter Property="Margin" Value="5,7,5,0"></Setter>
		</Style>
		<Style x:Key="NotificationContent" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"></Setter>
			<Setter Property="FontSize" Value="11"></Setter>
			<Setter Property="FontWeight" Value="Normal"></Setter>
			<Setter Property="Margin" Value="5,3,5,5"></Setter>
		</Style>
		<Storyboard x:Key="NotificationEnter">
			<DoubleAnimation Storyboard.TargetName="BackgroundHeightChange" Storyboard.TargetProperty="Height" From="15" To="0" Duration="0:0:0.4"/>
			<DoubleAnimation Storyboard.TargetName="HeaderBar" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
		</Storyboard>
		<Storyboard x:Key="NotificationLeave">
			<DoubleAnimation Storyboard.TargetName="BackgroundHeightChange" Storyboard.TargetProperty="Height" From="0" To="15" Duration="0:0:0.4"/>
			<DoubleAnimation Storyboard.TargetName="HeaderBar" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.4" />
		</Storyboard>
	</Window.Resources>
	<Window.Triggers>
		<EventTrigger RoutedEvent="UIElement.MouseEnter" SourceName="Root">
			<BeginStoryboard Storyboard="{DynamicResource NotificationEnter}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="UIElement.MouseLeave" SourceName="Root">
			<BeginStoryboard Storyboard="{DynamicResource NotificationLeave}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="UIElement.TouchEnter" SourceName="Root">
			<BeginStoryboard Storyboard="{DynamicResource NotificationEnter}"></BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="UIElement.TouchLeave" SourceName="Root">
			<BeginStoryboard Storyboard="{DynamicResource NotificationLeave}"></BeginStoryboard>
		</EventTrigger>
	</Window.Triggers>
	<Grid>
		<Border Name="NotificationUI" Style="{DynamicResource NotificationRegionBorder}">
			<Grid>
				<Grid Name="BackgroundContainer" SizeChanged="BackgroundContainer_SizeChanged">
					<Grid Name="BackgroundHeightChange" SizeChanged="BackgroundContainer_SizeChanged" Visibility="Visible" Style="{DynamicResource NotificationHeightClipContainer}"></Grid>
					<Grid>
						<Border Style="{DynamicResource NotificationBaseBackground}"></Border>
						<Border Style="{DynamicResource NotificationBackgroundHighlight}"></Border>
						<nt:Slice9Image Style="{DynamicResource NotificationBackgroundImageSlice9}"></nt:Slice9Image>
						<Border Style="{DynamicResource NotificationBorder}"></Border>
						<StackPanel Name="HeaderBar" Style="{DynamicResource NotificationHeader}">
							<Button Name="OptionsButton" Style="{DynamicResource NotificationOptionsButton}"></Button>
							<Button Name="CloseButton" Click="CloseButton_Click" Style="{DynamicResource NotificationCloseButton}"></Button>
						</StackPanel>
						<Control Style="{DynamicResource NotificationTimeout}"></Control>
					</Grid>
				</Grid>
				<Image Name="Icon" Source="Images\default.ico" Style="{DynamicResource NotificationIcon}"></Image>
				<Image Name="IconRef" Source="Images\default.ico" Style="{DynamicResource NotificationIconReflection}"></Image>
				<nt:Slice9Image Style="{DynamicResource NotificationTextAreaBackgroundImageSlice9}"></nt:Slice9Image>
				<Border Name="TextAreaBorderOuter" Style="{DynamicResource NotificationTextAreaOuterBorder}">
					<Border Name="TextAreaBorderInner" Style="{DynamicResource NotificationTextAreaInnerBorder}">
						<Border Name="TextAreaTextArea" Style="{DynamicResource NotificationTextAreaTextPart}">
							<ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Style="{DynamicResource AutoHideScrollViewer}">
								<StackPanel MouseDown="ScrollViewer_MouseDown" MouseUp="ScrollViewer_MouseUp" TouchDown="ScrollViewer_TouchDown" TouchUp="ScrollViewer_TouchUp">
									<TextBlock Name="MessageTitle" TextWrapping="Wrap" Style="{DynamicResource NotificationTitle}" HorizontalAlignment="Left">Stay current with automatic updates</TextBlock>
									<TextBlock Name="MessageContent" TextWrapping="Wrap" Style="{DynamicResource NotificationContent}">Click here to learn how to keep your computer up to date automatically with important downloads from Windows Update.</TextBlock>
								</StackPanel>
							</ScrollViewer>
						</Border>
					</Border>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>
