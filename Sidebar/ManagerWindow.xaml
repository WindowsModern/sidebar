<Window x:Class="Sidebar.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sidebar"
        mc:Ignorable="d"
        Title="Manager" Height="580" Width="780"
        MinHeight="400" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded" Closed="Window_Closed"
        Background="{x:Null}" SnapsToDevicePixels="True">

	<Window.Resources>
		<local:ObjectToVisibilityConverter x:Key="ObjectToVisibilityConverter"/>
		<local:StringResourceConverter x:Key="StringResource"/>
		<SolidColorBrush x:Key="AeroBlue1" Color="#FFDCE8F6"/>
		<SolidColorBrush x:Key="AeroBlue2" Color="#FFE6F0FA"/>
		<SolidColorBrush x:Key="AeroBlue3" Color="#FFFAFCFD"/>
		<SolidColorBrush x:Key="AeroBorder" Color="#FF7F9DB9"/>
		<SolidColorBrush x:Key="AeroHeaderBg" Color="#FFDCE8F6"/>
		<SolidColorBrush x:Key="AeroItemHover" Color="#4DABABAB"/>
		<SolidColorBrush x:Key="AeroItemSelected" Color="#FF3C7FB1"/>
		<SolidColorBrush x:Key="AeroItemSelectedText" Color="#FFFFFFFF"/>
		<SolidColorBrush x:Key="AeroGlow" Color="#80FFFFFF"/>
		<SolidColorBrush x:Key="AeroDarkBorder" Color="#FF6183B2"/>
		<LinearGradientBrush x:Key="AeroWindowBg" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#FFF0F6FF" Offset="0"/>
			<GradientStop Color="#FFDCE8F8" Offset="1"/>
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="AeroTitleBg" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#B2FFFFFF" Offset="0"/>
			<GradientStop Color="#4DFFFFFF" Offset="1"/>
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="AeroButtonBg" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#FFF1F4F9" Offset="0"/>
			<GradientStop Color="#FFDCE6F4" Offset="1"/>
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="AeroButtonHover" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#FFF5F8FC" Offset="0"/>
			<GradientStop Color="#FFE8F0FA" Offset="1"/>
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="AeroButtonPressed" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#FFC2D1E7" Offset="0"/>
			<GradientStop Color="#FFAEC3DE" Offset="1"/>
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="AeroListSelected" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#FF3C7FB1" Offset="0"/>
			<GradientStop Color="#FF2A6A9A" Offset="1"/>
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="AeroListSelectedFocused" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="#FF3399FF" Offset="0"/>
			<GradientStop Color="#FF1E7ACC" Offset="1"/>
		</LinearGradientBrush>
		<Style x:Key="VistaButton" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource AeroButtonBg}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AeroBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,5"/>
			<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
							<ContentPresenter x:Name="content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource AeroButtonHover}"/>
								<Setter TargetName="border" Property="BorderBrush" Value="#FF3C7FB1"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource AeroButtonPressed}"/>
								<Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AeroDarkBorder}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Opacity" Value="0.5"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<DataTemplate x:Key="TileItemTemplate">
			<Border x:Name="ItemBorder" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="4,2"
                    SnapsToDevicePixels="True">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Image Source="{Binding Logo}" 
                           Width="24" Height="24" 
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0"/>
					<TextBlock Text="{Binding Title}" 
                               FontSize="12" 
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
				</StackPanel>
			</Border>
			<DataTemplate.Triggers>
				<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}" Value="True">
					<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AeroListSelected}"/>
					<Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AeroDarkBorder}"/>
					<Setter TargetName="ItemBorder" Property="BorderThickness" Value="0,0,0,1"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}" Value="True">
					<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AeroItemHover}"/>
				</DataTrigger>
			</DataTemplate.Triggers>
		</DataTemplate>
		<Style x:Key="GroupHeaderStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource AeroHeaderBg}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AeroBorder}"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
		</Style>
		<Style x:Key="GroupContainerStyle" TargetType="Border">
			<Setter Property="BorderBrush" Value="{DynamicResource AeroBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="0"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
		</Style>
	</Window.Resources>
	<Border Background="{DynamicResource AeroWindowBg}">
		<Grid Margin="8">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Border Grid.Row="0" Height="32" CornerRadius="0" 
                    BorderBrush="{DynamicResource AeroBorder}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource AeroTitleBg}" Margin="0,0,0,6">
				<TextBlock x:Name="TitleText" 
                           Text="{Binding Source='TILEMGR_WINTITLE', Converter={StaticResource StringResource}}"
                           FontSize="14" FontWeight="SemiBold"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           Foreground="#203A56"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
			</Border>
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="240"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Border Grid.Column="0" 
                        BorderBrush="{DynamicResource AeroBorder}" BorderThickness="1"
                        Background="White" CornerRadius="0"
                        SnapsToDevicePixels="True">
					<ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0" Style="{DynamicResource AutoHideScrollViewer}">
						<StackPanel>
							<Border Style="{DynamicResource GroupHeaderStyle}">
								<TextBlock x:Name="AvailableHeader" Text="{Binding Source='TILEMGR_VALIDTILES', Converter={StaticResource StringResource}}" FontWeight="Bold" FontSize="11"
                                           FontFamily="{DynamicResource GlobalFontFamily}"/>
							</Border>
							<Border Style="{DynamicResource GroupContainerStyle}" BorderThickness="0,0,0,1">
								<ListBox x:Name="AvailableList"
                                         ItemsSource="{Binding AvailableTiles}"
                                         ItemTemplate="{DynamicResource TileItemTemplate}"
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Height="140"
                                         SelectionChanged="TileList_SelectionChanged">
									<ListBox.ItemContainerStyle>
										<Style TargetType="ListBoxItem">
											<Setter Property="Padding" Value="0"/>
											<Setter Property="Focusable" Value="True"/>
											<Setter Property="IsTabStop" Value="True"/>
											<Style.Triggers>
												<Trigger Property="IsSelected" Value="True">
													<Setter Property="Background" Value="{DynamicResource AeroListSelected}"/>
													<Setter Property="Foreground" Value="White"/>
												</Trigger>
											</Style.Triggers>
										</Style>
									</ListBox.ItemContainerStyle>
								</ListBox>
							</Border>
							<Border Style="{DynamicResource GroupHeaderStyle}" Margin="0,6,0,0">
								<TextBlock x:Name="PinnedTopHeader" Text="{Binding Source='TILEMGR_PINNEDTILES', Converter={StaticResource StringResource}}" FontWeight="Bold" FontSize="11"
                                           FontFamily="{DynamicResource GlobalFontFamily}"/>
							</Border>
							<Border Style="{DynamicResource GroupContainerStyle}" BorderThickness="0,0,0,1">
								<ListBox x:Name="PinnedTopList"
                                         ItemsSource="{Binding PinnedTopTiles}"
                                         ItemTemplate="{DynamicResource TileItemTemplate}"
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Height="100"
                                         SelectionChanged="TileList_SelectionChanged">
									<ListBox.ItemContainerStyle>
										<Style TargetType="ListBoxItem">
											<Setter Property="Padding" Value="0"/>
											<Setter Property="Focusable" Value="True"/>
											<Setter Property="IsTabStop" Value="True"/>
											<Style.Triggers>
												<Trigger Property="IsSelected" Value="True">
													<Setter Property="Background" Value="{DynamicResource AeroListSelected}"/>
													<Setter Property="Foreground" Value="White"/>
												</Trigger>
											</Style.Triggers>
										</Style>
									</ListBox.ItemContainerStyle>
								</ListBox>
							</Border>
							<Border Style="{DynamicResource GroupHeaderStyle}" Margin="0,6,0,0">
								<TextBlock x:Name="PinnedBottomHeader" Text="{Binding Source='TILEMGR_PINNEDBOTTOMTILES', Converter={StaticResource StringResource}}" FontWeight="Bold" FontSize="11"
                                           FontFamily="{DynamicResource GlobalFontFamily}"/>
							</Border>
							<Border Style="{DynamicResource GroupContainerStyle}" BorderThickness="0,0,0,1">
								<ListBox x:Name="PinnedBottomList"
                                         ItemsSource="{Binding PinnedBottomTiles}"
                                         ItemTemplate="{DynamicResource TileItemTemplate}"
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Height="100"
                                         SelectionChanged="TileList_SelectionChanged">
									<ListBox.ItemContainerStyle>
										<Style TargetType="ListBoxItem">
											<Setter Property="Padding" Value="0"/>
											<Setter Property="Focusable" Value="True"/>
											<Setter Property="IsTabStop" Value="True"/>
											<Style.Triggers>
												<Trigger Property="IsSelected" Value="True">
													<Setter Property="Background" Value="{DynamicResource AeroListSelected}"/>
													<Setter Property="Foreground" Value="White"/>
												</Trigger>
											</Style.Triggers>
										</Style>
									</ListBox.ItemContainerStyle>
								</ListBox>
							</Border>
						</StackPanel>
					</ScrollViewer>
				</Border>
				<GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" 
                              VerticalAlignment="Stretch" Background="Transparent"
                              PreviewMouseMove="GridSplitter_PreviewMouseMove"/>
				<Border Grid.Column="2" 
                        BorderBrush="{DynamicResource AeroBorder}" BorderThickness="1"
                        Background="White" CornerRadius="0"
                        Padding="16,12">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<Grid Grid.Row="0" Margin="0,0,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="64"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Image Grid.Column="0" 
                                   x:Name="DetailIcon"
                                   Width="56" Height="56"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Top"
                                   Source="{Binding SelectedItem.Logo}"/>
							<StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
								<TextBlock x:Name="DetailTitle" 
                                           Text="{Binding SelectedItem.Title}"
                                           FontSize="16" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource GlobalFontFamily}"
                                           TextWrapping="Wrap"/>
								<TextBlock x:Name="DetailPublisher" 
                                           Text="{Binding SelectedItem.Publisher}"
                                           FontSize="11" Foreground="#555555"
                                           FontFamily="{DynamicResource GlobalFontFamily}"
                                           Margin="0,2,0,0"/>
								<TextBlock x:Name="DetailVersion" 
                                           Text="{Binding SelectedItem.Version}"
                                           FontSize="11" Foreground="#555555"
                                           FontFamily="{DynamicResource GlobalFontFamily}"/>
							</StackPanel>
						</Grid>
						<TextBlock x:Name="EmptyHint" Grid.Row="1"
                                   Text="{Binding Source='TILEMGR_SELECTAITEM', Converter={StaticResource StringResource}}"
                                   FontSize="12" Foreground="#888888"
                                   FontFamily="{DynamicResource GlobalFontFamily}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding SelectedItem, Converter={StaticResource ObjectToVisibilityConverter}, ConverterParameter=CollapsedWhenNull}"/>
						<Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" 
                                Padding="0,8,0,0" Margin="0,4,0,0"
                                Visibility="{Binding SelectedItem, Converter={StaticResource ObjectToVisibilityConverter}}">
							<ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
								<TextBlock x:Name="DetailDescription" 
                                           Text="{Binding SelectedItem.Description}"
                                           FontSize="11" Foreground="#333333"
                                           FontFamily="{DynamicResource GlobalFontFamily}"
                                           TextWrapping="Wrap"/>
							</ScrollViewer>
						</Border>
						<Border Grid.Row="5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0" Margin="0,8,0,0">
							<WrapPanel>
								<Button x:Name="AddButton" 
                                        Style="{DynamicResource VistaButton}"
                                        Content="{Binding Source='TILEMGR_ADDTO', Converter={StaticResource StringResource}}"
                                        Click="AddButton_Click"
                                        IsEnabled="False"
                                        Margin="0,0,8,0"
                                        Padding="16,6"/>
								<Button x:Name="UnpinButton"
                                        Style="{DynamicResource VistaButton}"
                                        Content="{Binding Source='TILEMGR_REMOVE', Converter={StaticResource StringResource}}"
                                        Click="UnpinButton_Click"
                                        IsEnabled="False"
                                        Margin="0,0,8,0"
                                        Padding="16,6"/>
								<Button x:Name="DeleteButton"
                                        Style="{DynamicResource VistaButton}"
                                        Content="{Binding Source='TILEMGR_DELETE', Converter={StaticResource StringResource}}"
                                        Click="DeleteButton_Click"
                                        IsEnabled="False"
                                        Padding="16,6"/>
							</WrapPanel>
						</Border>
					</Grid>
				</Border>
			</Grid>
			<Border Grid.Row="2" Height="24" Margin="0,6,0,0"
                    BorderBrush="{DynamicResource AeroBorder}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource AeroTitleBg}">
				<DockPanel>
					<StackPanel Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource GlobalFontFamily}">
						<Hyperlink Click="Hyperlink_Click">
							<Run Text="{Binding Path=., Source='SIDEBAR_CONTEXTMENU_STORE', Converter={StaticResource StringResource}}" />
						</Hyperlink>
						</TextBlock>
						<Separator Margin="5,0"></Separator>
						<TextBlock x:Name="StatusText" 
                           Text="{Binding Source='TILEMGR_STATUS_READY', Converter={StaticResource StringResource}}"
                           FontSize="11" Foreground="#444444"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
					</StackPanel>
				</DockPanel>
			</Border>
		</Grid>
	</Border>
</Window>