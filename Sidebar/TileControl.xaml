<UserControl x:Class="Sidebar.TileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:pst="clr-namespace:Sidebar.Presentation"
             xmlns:local="clr-namespace:Sidebar"
			 x:Name="RootTileElement"
             mc:Ignorable="d" Background="Transparent" Visibility="Hidden"
			 Loaded="RootTileElement_Loaded" Unloaded="RootTileElement_Unloaded" SizeChanged="RootTileElement_SizeChanged"
             d:DesignHeight="300" d:DesignWidth="300">
	<UserControl.Resources>
		<Storyboard x:Key="TileFirstLoadAnimation" Completed="TileFirstLoadStoryboard_Completed">
			<DoubleAnimation Storyboard.TargetName="RootTileElement" Storyboard.TargetProperty="Height" From="0" To="100" Duration="0:0:0.5" FillBehavior="Stop"/>
			<DoubleAnimation Storyboard.TargetName="TileMainPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
		</Storyboard>
		<Storyboard x:Key="TileUnloadAnimation">
			<DoubleAnimation Storyboard.TargetName="RootTileElement" Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.5" BeginTime="0:0:0.25"/>
			<DoubleAnimation Storyboard.TargetName="TileMainPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
		</Storyboard>
		<Storyboard x:Key="TileHeightChangeAnimation" Completed="TileHeightChangeAnimation_Completed">
			<DoubleAnimation Storyboard.TargetName="TileContentContainerControl" Storyboard.TargetProperty="Height" From="0" To="100" Duration="0:0:0.5" FillBehavior="Stop"/>
		</Storyboard>
	</UserControl.Resources>
	<UserControl.Triggers>
		<EventTrigger RoutedEvent="MouseEnter">
			<BeginStoryboard Storyboard="{DynamicResource TileShowFlyoutIconWhenEnter}"/>
		</EventTrigger>
		<EventTrigger RoutedEvent="MouseLeave">
			<BeginStoryboard Storyboard="{DynamicResource TileShowFlyoutIconWhenLeave}"/>
		</EventTrigger>
		<EventTrigger RoutedEvent="TouchEnter">
			<BeginStoryboard Storyboard="{DynamicResource TileShowFlyoutIconWhenEnter}"/>
		</EventTrigger>
		<EventTrigger RoutedEvent="TouchLeave">
			<BeginStoryboard Storyboard="{DynamicResource TileShowFlyoutIconWhenLeave}"/>
		</EventTrigger>
	</UserControl.Triggers>
	<UserControl.ContextMenu>
		<ContextMenu Name="TileContextMenu" Opened="TileContextMenu_Opened" Closed="TileContextMenu_Closed">
			<Separator Name="MenuItemTileContextMenuItemSeparator" Visibility="Collapsed"></Separator>
			<MenuItem Name="MenuItemAutoSize" IsCheckable="True" Click="MenuItemAutoSize_Click" Header="{pst:StringResource TILE_CONTEXTMENU_AUTOSIZE}"></MenuItem>
			<Separator Name="MenuItemSeparatorForTile1" />
			<MenuItem Name="MenuItemPinnedBottom" IsCheckable="True" Click="MenuItemPinnedBottom_Click" Header="{pst:StringResource TILE_CONTEXTMENU_PIN}"></MenuItem>
			<Separator Name="MenuItemSeparatorForTile2" />
			<MenuItem Name="MenuItemMoveUp" Click="MenuItemMoveUp_Click" Header="{pst:StringResource TILE_CONTEXTMENU_MOVEUP}"></MenuItem>
			<MenuItem Name="MenuItemMoveDown" Click="MenuItemMoveDown_Click" Header="{pst:StringResource TILE_CONTEXTMENU_MOVEDOWN}"></MenuItem>
			<Separator Name="MenuItemSeparatorForTile3"/>
			<MenuItem Name="MenuItemProperties" Click="MenuItemProperties_Click" Header="{pst:StringResource TILE_CONTEXTMENU_PROP}"></MenuItem>
			<MenuItem Name="MenuItemRemoveFromOverflow" Visibility="Collapsed" IsEnabled="False" Click="MenuItemRemoveFromOverflow_Click" Header="{pst:StringResource TILE_CONTEXTMENU_REMOVEOVERFLOW}"></MenuItem>
			<MenuItem Name="MenuItemRemove" Click="MenuItemRemove_Click" Header="{pst:StringResource TILE_CONTEXTMENU_REMOVE}"></MenuItem>
		</ContextMenu>
	</UserControl.ContextMenu>
	<Grid>
		<DockPanel>
			<Thumb Name="TileSplitterThumb" Style="{DynamicResource TileSplliter}" DragStarted="TileSplitterThumb_DragStarted" DragDelta="TileSplitterThumb_DragDelta" DragCompleted="TileSplitterThumb_DragCompleted" PreviewMouseLeftButtonDown="TileSplitterThumb_PreviewMouseLeftButtonDown"></Thumb>
			<Grid Name="TileMainPanel" Opacity="0">
				<Control Style="{DynamicResource TileBackground}"></Control>
				<DockPanel>
					<Grid Style="{DynamicResource TileHeaderContainer}">
						<Control Style="{DynamicResource TileHeaderBackground}"></Control>
						<DockPanel>
							<Image Name="TileDisplayImageControl" Style="{DynamicResource TileHeaderIcon}"></Image>
							<TextBlock Name="TileDisplayNameControl" Style="{DynamicResource TileHeaderDisplayName}"></TextBlock>
						</DockPanel>
						<Control Style="{DynamicResource TileHeaderHighlight}" IsHitTestVisible="False"></Control>
					</Grid>
					<Grid Name="TileContentControlContainer">
						<Control Style="{DynamicResource TileContentBackground}"></Control>
						<Grid Name="TileContentContainerControl" Style="{DynamicResource TileContentContainer}" SizeChanged="TileContentContainerControl_SizeChanged">
							<Grid Name="TileContentContainer" SizeChanged="TileContentContainer_SizeChanged"></Grid>
						</Grid>
						<Control Style="{DynamicResource TileContentHighlight}" IsHitTestVisible="False"></Control>
					</Grid>
				</DockPanel>
				<Control Style="{DynamicResource TileHighlight}" IsHitTestVisible="False"></Control>
			</Grid>
		</DockPanel>
		<Control Name="FlyoutIcon" Style="{DynamicResource TileFlyoutIcon}"></Control>
    </Grid>
</UserControl>
