	</Style>
	<Style x:Key="NotificationTimeout" TargetType="Control">
		<Setter Property="Width" Value="5" />
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Margin" Value="0,-10,0,0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<snt:Slice9Image SliceThickness="0,10,0,0" Source="Images\NotificationTimeout.png" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="NotificationHeightClipContainer" TargetType="Grid">
		<Setter Property="Width" Value="0" />
		<Setter Property="Height" Value="15" />
		<Setter Property="Tag" Value="5" />
	</Style>
	<Style x:Key="NotificationTitle" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Margin" Value="3,3,3,0" />
		<Setter Property="Foreground" Value="Black" />
	</Style>
	<Style x:Key="NotificationContent" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Margin" Value="3" />
		<Setter Property="Foreground" Value="Black" />
	</Style>
	<Storyboard x:Key="NotificationEnter">
		<DoubleAnimation
			Storyboard.TargetName="BackgroundHeightChange"
			Storyboard.TargetProperty="Height"
			From="15"
			To="0"
			Duration="0:0:0.4" />
		<DoubleAnimation
			Storyboard.TargetName="HeaderBar"
			Storyboard.TargetProperty="Opacity"
			From="0"
			To="1"
			Duration="0:0:0.4" />
	</Storyboard>
	<Storyboard x:Key="NotificationLeave">
		<DoubleAnimation
			Storyboard.TargetName="BackgroundHeightChange"
			Storyboard.TargetProperty="Height"
			From="0"
			To="15"
			Duration="0:0:0.4" />
		<DoubleAnimation
			Storyboard.TargetName="HeaderBar"
			Storyboard.TargetProperty="Opacity"
			From="1"
			To="0"
			Duration="0:0:0.4" />
	</Storyboard>
	<Storyboard x:Key="NotificationLoaded" />
	<Storyboard x:Key="NotificationUnloaded" />
