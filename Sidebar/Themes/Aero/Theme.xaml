	<!--  Tray & QuickLaunch IconItem  -->
	<Style x:Key="TileIconItemButtonStyle" TargetType="ToggleButton">
		<Setter Property="Width" Value="24" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

						<snt:Slice9Image
							x:Name="HoverImage"
							Opacity="0"
							SliceThickness="4"
							Source="{DynamicResource TileIconItemHoverImage}" />

						<snt:Slice9Image
							x:Name="PressedImage"
							Opacity="0"
							SliceThickness="4"
							Source="{DynamicResource TileIconItemActiveImage}" />

						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Grid>

					<ControlTemplate.Triggers>

						<!--  Hover：只有未按下时显示  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsMouseOver" Value="True" />
								<Condition Property="IsPressed" Value="False" />
							</MultiTrigger.Conditions>

							<Setter TargetName="HoverImage" Property="Opacity" Value="1" />
						</MultiTrigger>

						<!--  Pressed：按下时显示  -->
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="PressedImage" Property="Opacity" Value="1" />
						</Trigger>

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--  Tray  -->
	<Style
		x:Key="TileIconItemForTrayTile"
		BasedOn="{StaticResource TileIconItemButtonStyle}"
		TargetType="ToggleButton">
