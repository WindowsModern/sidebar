			</Setter.Value>
		</Setter>
		<Setter Property="Margin" Value="16,15,5,0" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="BorderThickness" Value="0" />
	</Style>
	<Style x:Key="NotificationTextAreaInnerBorder" TargetType="Border">
		<Setter Property="BorderBrush">
