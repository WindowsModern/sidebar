	<!--  Materials  -->
	<!--  Buttons  -->
	<Style x:Key="TileButtonsUpButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="Root">
						<Image x:Name="Normal" Source="Images\TBUpNormal.png" />
						<Image
							x:Name="Hover"
							Opacity="0"
							Source="Images\TBUpLight.png" />
						<Image
							x:Name="Active"
							Opacity="0"
							Source="Images\TBUpPress.png" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Hover"
											Storyboard.TargetProperty="Opacity"
											To="1"
											Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Hover"
											Storyboard.TargetProperty="Opacity"
											To="0"
											Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Active"
											Storyboard.TargetProperty="Opacity"
											To="1"
											Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Active"
											Storyboard.TargetProperty="Opacity"
											To="0"
											Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Root" Property="Opacity" Value="0.3" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="True">
							<Setter TargetName="Root" Property="Opacity" Value="1" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
