<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Sidebar"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	xmlns:snt="clr-namespace:Sidebar;assembly=Native">
	<!-- Infomation -->
	<s:String x:Key="ThemeDisplayName">Vista</s:String>
	<s:String x:Key="ThemePublisherDisplayName">LongBar Project Group</s:String>
	<s:String x:Key="ThemeDescription">Vista theme.</s:String>
	<s:String x:Key="ThemeLogo">Logo.jpg</s:String>
	<!--  Options  -->
	<s:Boolean x:Key="EnableBlur">true</s:Boolean>
	<s:Boolean x:Key="EnableBlurForFlyout">true</s:Boolean>
	<s:Boolean x:Key="EnableBlurForDrag">true</s:Boolean>
	<!--  Styles  -->
	<SolidColorBrush x:Key="GlobalForegroundBrush" Color="White" />
	<s:Double x:Key="GlobalFontSize">10</s:Double>
	<s:Double x:Key="GlobalNormalFontSize">10</s:Double>
	<s:Double x:Key="GlobalNormalFontSizeSmall">9</s:Double>
	<!--  Sidebar  -->
	<Style x:Key="SidebarBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid x:Name="RootGrid" Background="Transparent" RenderTransformOrigin="0.5,0.5">
						<Grid.RenderTransform>
							<ScaleTransform ScaleX="1" />
						</Grid.RenderTransform>
						<Grid>
							<Border Background="{DynamicResource UtilDwmOpaqueThemeBrush}" Opacity="0.6" />
							<Border Background="Black" Opacity="0.1" />
							<Border HorizontalAlignment="Left" Width="2">
								<Border.Background>
									<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
										<GradientStop Offset="0.0" Color="#BB000000" />
										<GradientStop Offset="0.5" Color="#BB000000" />
										<GradientStop Offset="0.5" Color="#66FFFFFF" />
										<GradientStop Offset="1.0" Color="#66FFFFFF" />
									</LinearGradientBrush>
								</Border.Background>
							</Border>
						</Grid>
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
							<Setter TargetName="RootGrid" Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleX="-1" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<ControlTemplate x:Key="SidebarOptionsSplliterTemplate" TargetType="Control">
		<Border VerticalAlignment="Bottom" Height="2">
			<Border.Background>
				<LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
					<GradientStop Offset="0.0" Color="#BB000000" />
					<GradientStop Offset="0.5" Color="#BB000000" />
					<GradientStop Offset="0.5" Color="#66FFFFFF" />
					<GradientStop Offset="1.0" Color="#66FFFFFF" />
				</LinearGradientBrush>
			</Border.Background>
		</Border>
	</ControlTemplate>
	<Style x:Key="SidebarOptionsSplliter" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="2" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Margin" Value="0,17,0,0" />
		<Setter Property="Template" Value="{DynamicResource SidebarOptionsSplliterTemplate}"></Setter>
	</Style>
	<Style x:Key="SidebarOverflowPartSplliter" TargetType="Control">
