	<!-- Tile -->
	<ControlTemplate x:Key="TileSplliterTemplate" TargetType="Control">
		<Grid>
			<Border x:Name="Normal" VerticalAlignment="Bottom" Height="2">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
						<GradientStop Offset="0.0" Color="#BB000000" />
						<GradientStop Offset="0.5" Color="#BB000000" />
						<GradientStop Offset="0.5" Color="#66FFFFFF" />
						<GradientStop Offset="1.0" Color="#66FFFFFF" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>
			<Border x:Name="Hover" VerticalAlignment="Bottom" Height="2" Opacity="0">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
						<GradientStop Offset="0.0" Color="#66000000" />
						<GradientStop Offset="0.5" Color="#BB000000" />
						<GradientStop Offset="0.5" Color="#BBFFFFFF" />
						<GradientStop Offset="1.0" Color="#BBFFFFFF" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="Normal" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
							<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
							<DoubleAnimation Storyboard.TargetName="Normal" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style x:Key="TileSplliter" TargetType="Thumb">
		<Setter Property="DockPanel.Dock" Value="Bottom"></Setter>
		<Setter Property="Height" Value="4"></Setter>
		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="Background" Value="Transparent"></Setter>
		<Setter Property="Template" Value="{DynamicResource TileSplliterTemplate}"></Setter>
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsPinned, ElementName=RootTileElement}" Value="True">
				<Setter Property="DockPanel.Dock" Value="Top"/>
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<!--  Flyout  -->
	<ControlTemplate x:Key="FlyoutBackgroundTemplate" TargetType="Control">
		<Grid>
			<Border x:Name="FlyoutBackgroundFill" Background="#10FFFFFF" />
			<Border x:Name="FlyoutBorderBehind" BorderBrush="#71000000" BorderThickness="1" />
		</Grid>
	</ControlTemplate>
	<Style x:Key="FlyoutBackground" TargetType="Control">
		<Setter Property="Template" Value="{DynamicResource FlyoutBackgroundTemplate}" />
	</Style>
	<!--  Drag  -->
	<Style x:Key="DragWindowBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid x:Name="RootGrid" Background="Transparent" RenderTransformOrigin="0.5,0.5">
						<Grid.RenderTransform>
							<ScaleTransform ScaleX="1" />
						</Grid.RenderTransform>
						<Grid>
							<Border Background="{DynamicResource UtilDwmOpaqueThemeBrush}" Opacity="0.6" />
							<Border Background="Black" Opacity="0.1" />
							<Border BorderBrush="#BB000000" BorderThickness="1">
								<Border BorderBrush="#66FFFFFF" BorderThickness="1"></Border>
							</Border>
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="DragWindowContentContainer" TargetType="Grid">
		<Setter Property="Margin" Value="10"></Setter>
	</Style>

	<!--  Search  -->
	<!--  Search:Flyout  -->
	<Style x:Key="TileSearchFlyoutCustomNextButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="23" />
		<Setter Property="Height" Value="23" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Image
						x:Name="Img"
						Margin="-4,-2,-4,-4"
						Source="Images\SearchNextNormal.png" />
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Img" Property="Source" Value="Images\SearchNextLight.png" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Img" Property="Source" Value="Images\SearchNextPress.png" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Img" Property="Source" Value="Images\SearchNextDisabled.png" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Image Buttons  -->
	<Style x:Key="TileButtonsLeftButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="Root">
						<Image x:Name="Normal" Source="Images\TBLeftNormal.png" />
						<Image
							x:Name="Hover"
							Opacity="0"
							Source="Images\TBLeftLight.png" />
						<Image
							x:Name="Active"
							Opacity="0"
							Source="Images\TBLeftPress.png" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Hover"
											Storyboard.TargetProperty="Opacity"
											To="1"
											Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Hover"
											Storyboard.TargetProperty="Opacity"
											To="0"
											Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Active"
											Storyboard.TargetProperty="Opacity"
											To="1"
											Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Active"
											Storyboard.TargetProperty="Opacity"
											To="0"
											Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Root" Property="Opacity" Value="0.3" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="True">
							<Setter TargetName="Root" Property="Opacity" Value="1" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
