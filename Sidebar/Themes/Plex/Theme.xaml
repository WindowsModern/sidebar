<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Sidebar"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	xmlns:snt="clr-namespace:Sidebar;assembly=Native">
	<!--  Options  -->
	<s:Boolean x:Key="EnableBlur">false</s:Boolean>
	<s:Boolean x:Key="EnableNotificationBlur">false</s:Boolean>
	<s:Boolean x:Key="EnableNotificationClipRound">false</s:Boolean>
	<!--  Styles  -->
	<SolidColorBrush x:Key="GlobalForegroundBrush" Color="White" />
	<s:Double x:Key="GlobalFontSize">10</s:Double>
	<s:Double x:Key="GlobalNormalFontSize">10</s:Double>
	<s:Double x:Key="GlobalNormalFontSizeSmall">9</s:Double>
	<!--  Sidebar  -->
	<Style x:Key="Background" TargetType="Rectangle">
		<Setter Property="Fill">
			<Setter.Value>
				<LinearGradientBrush Opacity="1" StartPoint="0,0" EndPoint="1,0">
					<GradientStop Offset="0" Color="#5D7DAF" />
					<GradientStop Offset="0.04" Color="#5D7DAF" />
					<GradientStop Offset="0.5" Color="#3364AE" />
					<GradientStop Offset="1" Color="#365891" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="BackgroundHighlight" TargetType="Rectangle">
		<Setter Property="Width" Value="5" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="Stretch" Value="Fill" />
		<Setter Property="Fill">
			<Setter.Value>
				<LinearGradientBrush Opacity="1" StartPoint="0,0" EndPoint="1,0">
					<GradientStop Offset="0" Color="#2CFFFFFF" />
					<GradientStop Offset="1" Color="#1CFFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="BorderLine" TargetType="Line">
		<Setter Property="Stroke" Value="#3564A7" />
		<Setter Property="StrokeThickness" Value="1" />
	</Style>
	<Style x:Key="TileSplitterPanel" TargetType="StackPanel">
		<Setter Property="DockPanel.Dock" Value="Bottom" />
		<Setter Property="Height" Value="5" />
		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="Background" Value="#00000000" />
		<Setter Property="Opacity" Value="0.5" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetProperty="Opacity"
								To="1"
								Duration="0:0:0.2" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation
								Storyboard.TargetProperty="Opacity"
								To="0.5"
								Duration="0:0:0.2" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="TileSplitterTopBlankFill" TargetType="Rectangle">
		<Setter Property="Height" Value="3" />
		<Setter Property="Fill">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
					<GradientStop Offset="0" Color="#4AFFFFFF" />
					<GradientStop Offset="1" Color="#16FFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter Property="OpacityMask">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="#00000000" />
					<GradientStop Offset="1" Color="#FFFFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="TileSplitterLineTop" TargetType="Line">
		<Setter Property="X1" Value="0" />
		<Setter Property="X2" Value="200" />
		<Setter Property="Stretch" Value="UniformToFill" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Stroke">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="#52FFFFFF" />
					<GradientStop Offset="1" Color="#16FFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Opacity" Value="1" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="TileSplitterLineBottom" TargetType="Line">
		<Setter Property="X1" Value="0" />
		<Setter Property="X2" Value="200" />
		<Setter Property="Stretch" Value="UniformToFill" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Stroke">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="#38FFFFFF" />
					<GradientStop Offset="1" Color="#24FFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style
		x:Key="TileSplitterLineTopLighting"
		BasedOn="{StaticResource TileSplitterLineTop}"
		TargetType="Line" />
	<Style
		x:Key="TileSplitterLineBottomLighting"
		BasedOn="{StaticResource TileSplitterLineBottom}"
		TargetType="Line" />
	<Style x:Key="MainPanel" TargetType="DockPanel">
		<Setter Property="Margin" Value="0,30,0,0" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="LastChildFill" Value="True" />
	</Style>
	<Style
		x:Key="TileSplitterTopBlankFillLighting"
		BasedOn="{StaticResource TileSplitterTopBlankFill}"
		TargetType="Rectangle" />
	<!--  Top Options  -->
	<Style
		x:Key="TopOptionsText"
		BasedOn="{StaticResource GlobalTextBlockTextDisplay}"
		TargetType="TextBlock">
		<Setter Property="Foreground" Value="White" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="Margin" Value="0,4,0,0" />
	</Style>
	<Style x:Key="TopOptionsIcon" TargetType="Polygon">
		<Setter Property="Opacity" Value="0.45" />
		<Setter Property="Stroke" Value="#8ba8dd" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Fill" Value="White" />
		<Setter Property="Margin" Value="4,4,4,0" />
		<Setter Property="RenderTransformOrigin" Value="0.556,0.9" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="StrokeStartLineCap" Value="Round" />
		<Setter Property="StrokeEndLineCap" Value="Round" />
		<Setter Property="StrokeLineJoin" Value="Round" />
	</Style>
	<Style x:Key="TopOptionsPanel" TargetType="FrameworkElement">
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Height" Value="25" />
	</Style>
	<Style x:Key="TopOptionsPanelSplitter" TargetType="StackPanel">
		<Setter Property="Margin" Value="0,25,0,0" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Cursor" Value="Arrow" />
		<Setter Property="Background" Value="#00000000" />
		<Setter Property="Height" Value="4" />
	</Style>
	<!--  Tile  -->
	<Style x:Key="TilePanel" TargetType="DockPanel">
		<Setter Property="Background" Value="#00000000" />
	</Style>
	<Style x:Key="TileIcon" TargetType="Image">
		<Setter Property="DockPanel.Dock" Value="Right" />
		<Setter Property="Height" Value="15" />
		<Setter Property="Width" Value="15" />
	</Style>
	<Style
		x:Key="TileTitle"
		BasedOn="{StaticResource GlobalTextBlockTextDisplay}"
		TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="Margin" Value="5,0,5,0" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="FontWeight" Value="Bold" />
	</Style>
	<Style x:Key="TileContent" TargetType="Grid">
		<Setter Property="Background" Value="#00000000" />
		<Setter Property="Margin" Value="1,0,0,0" />
	</Style>
	<Style x:Key="TileFlyoutIcon" TargetType="Polygon">
		<Setter Property="Opacity" Value="0" />
		<Setter Property="Stroke" Value="#8ba8dd" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Fill" Value="White" />
		<Setter Property="Margin" Value="1,2,1,0" />
		<Setter Property="RenderTransformOrigin" Value="0.556,0.9" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="StrokeStartLineCap" Value="Round" />
		<Setter Property="StrokeEndLineCap" Value="Round" />
		<Setter Property="StrokeLineJoin" Value="Round" />
	</Style>
	<Style
		x:Key="PinnedTileIcon"
		BasedOn="{StaticResource TileIcon}"
		TargetType="Image" />
	<Style
		x:Key="PinnedTileTitle"
		BasedOn="{StaticResource TileTitle}"
		TargetType="TextBlock" />
	<Style x:Key="PinnedTileHeader" TargetType="DockPanel">
		<Setter Property="Visibility" Value="Collapsed" />
	</Style>
	<Style
		x:Key="PinnedTileFlyoutIcon"
		BasedOn="{StaticResource TileFlyoutIcon}"
		TargetType="Polygon">
		<Setter Property="Margin" Value="1,5,1,0" />
	</Style>
	<Style
		x:Key="PinnedTileContent"
		BasedOn="{StaticResource TileContent}"
		TargetType="Grid">
		<Setter Property="Margin" Value="0,0,1,0" />
	</Style>
	<Style
		x:Key="PinnedTileSplitterPanel"
		BasedOn="{StaticResource TileSplitterPanel}"
		TargetType="StackPanel">
		<Setter Property="DockPanel.Dock" Value="Top" />
	</Style>
	<!--  Flyout  -->
	<Style x:Key="FlyoutBorderBehind" TargetType="Rectangle">
		<Setter Property="Stroke" Value="#274B7A" />
		<Setter Property="StrokeThickness" Value="1" />
	</Style>
	<Style x:Key="FlyoutBackgroundFill" TargetType="Rectangle">
		<Setter Property="Fill">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="#FF6F8FC1" />
					<GradientStop Offset="0.35" Color="#FF5E7DB1" />
					<GradientStop Offset="1" Color="#FF4E6C9F" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="FlyoutBorder" TargetType="Rectangle">
		<Setter Property="Stroke" Value="#80FFFFFF" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Margin" Value="1" />
	</Style>
	<Style x:Key="FlyoutBackgroundHighlight" TargetType="Rectangle">
		<Setter Property="Height" Value="18" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Margin" Value="2,2,2,0" />
		<Setter Property="Fill">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="#90FFFFFF" />
					<GradientStop Offset="0.4" Color="#35FFFFFF" />
					<GradientStop Offset="1" Color="#00FFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="FlyoutBackgroundHighlight1" TargetType="Rectangle">
		<Setter Property="Height" Value="6" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Margin" Value="3,3,3,0" />
		<Setter Property="Fill">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="#BFFFFFFF" />
					<GradientStop Offset="1" Color="#30FFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<!--  Drag  -->
	<Style x:Key="DragPlaceholder" TargetType="Rectangle">
		<Setter Property="Margin" Value="0,0,0,0" />
		<Setter Property="Stroke" Value="#B3FFFFFF" />
		<Setter Property="StrokeThickness" Value="1.5" />
		<Setter Property="Opacity" Value="1" />
		<Setter Property="Fill">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="#33FFFFFF" />
					<GradientStop Offset="1" Color="#18FFFFFF" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
		<Setter Property="RenderTransform">
			<Setter.Value>
				<ScaleTransform ScaleX="1" ScaleY="1" />
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<EventTrigger RoutedEvent="Rectangle.Loaded">
				<BeginStoryboard>
					<Storyboard Duration="0:0:0.3">
						<DoubleAnimation
							Storyboard.TargetProperty="Opacity"
							From="1"
							To="0.2" />
						<DoubleAnimation
							Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
							From="1"
							To="0.6" />
						<DoubleAnimation
							Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
							From="1"
							To="0.6" />
					</Storyboard>
				</BeginStoryboard>
			</EventTrigger>
		</Style.Triggers>
	</Style>
	<!--  Notification  -->
	<Style x:Key="NotificationWindow" TargetType="Window">
		<Setter Property="MinWidth" Value="256" />
		<Setter Property="MinHeight" Value="72" />
		<Setter Property="MaxWidth" Value="358" />
		<Setter Property="MaxHeight" Value="293" />
	</Style>
	<Style x:Key="NotificationRegionBorder" TargetType="Border">
		<Setter Property="CornerRadius" Value="5" />
		<Setter Property="ClipToBounds" Value="True" />
		<Setter Property="Margin" Value="0,0,9,12" />
	</Style>
	<Style x:Key="NotificationBaseBackground" TargetType="Border">
		<Setter Property="Background" Value="#5289D6" />
		<Setter Property="CornerRadius" Value="5" />
	</Style>
	<Style x:Key="NotificationBackgroundImageSlice9" TargetType="snt:Slice9Image">
		<Setter Property="Source" Value="Images\NotificationHighlight.png" />
		<Setter Property="SliceThickness" Value="7,6" />
		<Setter Property="Margin" Value="0,16,0,1" />
	</Style>
	<Style x:Key="NotificationBackgroundHighlight" TargetType="Border">
		<Setter Property="Visibility" Value="Collapsed" />
	</Style>
	<Style x:Key="NotificationBorder" TargetType="Border">
		<Setter Property="Visibility" Value="Collapsed" />
	</Style>
	<Style x:Key="NotificationHeader" TargetType="StackPanel">
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Margin" Value="0,4,5,0" />
		<Setter Property="Height" Value="15" />
	</Style>
	<Style x:Key="NotificationOptionsButton" TargetType="Button">
		<Setter Property="Width" Value="Auto" />
		<Setter Property="Height" Value="Auto" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<StackPanel
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						Orientation="Horizontal">
						<TextBlock
							x:Name="PART_Text"
							FontFamily="{DynamicResource GlobalFontFamily}"
							FontSize="9"
							Foreground="White"
							Text="{TemplateBinding Content}" />
						<Polygon
							x:Name="PART_Polygon"
							Margin="2,0,0,0"
							VerticalAlignment="Center"
							Fill="White"
							Points="0,0 4,4 8,0" />
					</StackPanel>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_Text" Property="Foreground" Value="#FFE432" />
							<Setter TargetName="PART_Polygon" Property="Fill" Value="#FFE432" />
						</Trigger>
						<Trigger Property="IsStylusOver" Value="True">
							<Setter TargetName="PART_Text" Property="Foreground" Value="#FFE432" />
							<Setter TargetName="PART_Polygon" Property="Fill" Value="#FFE432" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="NotificationCloseButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid>
						<Image x:Name="Normal" Source="Images\CloseNormal.png" />
						<Image
							x:Name="Hover"
							Opacity="0"
							Source="Images\CloseLight.png" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Hover"
											Storyboard.TargetProperty="Opacity"
											To="1"
											Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetName="Hover"
											Storyboard.TargetProperty="Opacity"
											To="0"
											Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Margin" Value="5,0,0,0" />
	</Style>
	<Style x:Key="NotificationIcon" TargetType="Image">
		<Setter Property="Width" Value="16" />
		<Setter Property="Height" Value="16" />
		<Setter Property="Margin" Value="4,0,0,0" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style x:Key="NotificationIconReflection" TargetType="Image">
		<Setter Property="Width" Value="16" />
		<Setter Property="Height" Value="16" />
		<Setter Property="Margin" Value="4,32,0,0" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
		<Setter Property="Opacity" Value="0.4" />
		<Setter Property="Visibility" Value="Visible" />
	</Style>
	<Style x:Key="NotificationTextAreaOuterBorder" TargetType="Border">
		<Setter Property="BorderBrush">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Offset="0" Color="#80BABEC0" />
					<GradientStop Offset="0.5" Color="#00FFFFFF" />
					<GradientStop Offset="1" Color="#80BABEC0" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter Property="Margin" Value="20,19,4,6" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="BorderThickness" Value="0" />
	</Style>
	<Style x:Key="NotificationTextAreaInnerBorder" TargetType="Border">
		<Setter Property="BorderBrush">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Offset="0" Color="#8054585A" />
					<GradientStop Offset="0.25" Color="#80D0D8DA" />
					<GradientStop Offset="0.5" Color="#00FFFFFF" />
					<GradientStop Offset="0.75" Color="#80D0D8DA" />
					<GradientStop Offset="1" Color="#8054585A" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter Property="CornerRadius" Value="3" />
		<Setter Property="BorderThickness" Value="0" />
	</Style>
	<Style x:Key="NotificationTextAreaTextPart" TargetType="Border">
		<Setter Property="Margin" Value="3" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style x:Key="NotificationTextAreaBackgroundImageSlice9" TargetType="snt:Slice9Image">
		<Setter Property="Margin" Value="20,19,4,6" />
		<Setter Property="Source" Value="Images\TextBlock.png" />
		<Setter Property="SliceThickness" Value="7" />
	</Style>
	<Style x:Key="NotificationTimeout" TargetType="Control">
		<Setter Property="Width" Value="4" />
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Margin" Value="0,-25,1,0" />
		<Setter Property="Padding" Value="0,15,0,-15" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Border Margin="{TemplateBinding Padding}" ClipToBounds="True">
						<snt:Slice9Image SliceThickness="0,10,0,0" Source="Images\NotificationTimeout.png" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="NotificationHeightClipContainer" TargetType="Grid">
		<Setter Property="Width" Value="2" />
		<Setter Property="Height" Value="15" />
		<Setter Property="Tag" Value="5" />
	</Style>
	<Style x:Key="NotificationTitle" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Margin" Value="3,3,3,0" />
		<Setter Property="Foreground" Value="Black" />
	</Style>
	<Style x:Key="NotificationContent" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Margin" Value="3" />
		<Setter Property="Foreground" Value="#666666" />
	</Style>
	<Style x:Key="NotificationBackgroundContainer" TargetType="Grid" />
	<Style x:Key="NotificationIconPart" TargetType="Grid">
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Storyboard x:Key="NotificationEnter">
		<DoubleAnimation
			Storyboard.TargetName="BackgroundHeightChange"
			Storyboard.TargetProperty="Height"
			From="15"
			To="0"
			Duration="0:0:0.4" />
		<DoubleAnimation
			Storyboard.TargetName="BackgroundHeightChange"
			Storyboard.TargetProperty="Width"
			From="2"
			To="0"
			Duration="0:0:0.4" />
		<DoubleAnimation
			Storyboard.TargetName="HeaderBar"
			Storyboard.TargetProperty="Opacity"
			From="0"
			To="1"
			Duration="0:0:0.4" />
		<ThicknessAnimation
			Storyboard.TargetName="BackgroundHighlightImage"
			Storyboard.TargetProperty="Margin"
			From="0,16,0,2"
			To="0"
			Duration="0:0:0.4" />
		<ThicknessAnimation
			Storyboard.TargetName="TimeoutBar"
			Storyboard.TargetProperty="Padding"
			From="0,15,0,-15"
			To="0"
			Duration="0:0:0.4" />
		<!-- <ThicknessAnimation Storyboard.TargetName="TextAreaBackgroundImage" Storyboard.TargetProperty="Padding" From="20,19,4,6" To="20,19,4,4" Duration="0:0:0.4" /> -->
	</Storyboard>
	<Storyboard x:Key="NotificationLeave">
		<DoubleAnimation
			Storyboard.TargetName="BackgroundHeightChange"
			Storyboard.TargetProperty="Height"
			From="0"
			To="15"
			Duration="0:0:0.4" />
		<DoubleAnimation
			Storyboard.TargetName="BackgroundHeightChange"
			Storyboard.TargetProperty="Width"
			From="0"
			To="2"
			Duration="0:0:0.4" />
		<DoubleAnimation
			Storyboard.TargetName="HeaderBar"
			Storyboard.TargetProperty="Opacity"
			From="1"
			To="0"
