<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Sidebar"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	xmlns:snt="clr-namespace:Sidebar;assembly=Native">
	<s:String x:Key="ThemeDisplayName">Plex</s:String>
	<s:String x:Key="ThemePublisherDisplayName">Windows Modern</s:String>
	<s:String x:Key="ThemeDescription">Plex style in Windows Longhorn.</s:String>
	<s:String x:Key="ThemeLogo">Logo.png</s:String>
	<!--  Options  -->
	<s:Boolean x:Key="EnableBlur">false</s:Boolean>
	<s:Boolean x:Key="EnableNotificationBlur">false</s:Boolean>
	<s:Boolean x:Key="EnableNotificationClipRound">false</s:Boolean>
	<!--  Styles  -->
	<SolidColorBrush x:Key="GlobalForegroundBrush" Color="White" />
	<s:Double x:Key="GlobalFontSize">10</s:Double>
	<s:Double x:Key="GlobalNormalFontSize">10</s:Double>
	<s:Double x:Key="GlobalNormalFontSizeSmall">9</s:Double>
	<!-- Sidebar -->
	<ControlTemplate x:Key="SidebarBackgroundTemplate" TargetType="Control">
		<Grid x:Name="RootGrid" Background="Transparent" RenderTransformOrigin="0.5,0.5">
			<Grid.RenderTransform>
				<ScaleTransform ScaleX="1" />
			</Grid.RenderTransform>
			<Border>
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0" Color="#5D7DAF" />
						<GradientStop Offset="0.04" Color="#5D7DAF" />
						<GradientStop Offset="0.5" Color="#3364AE" />
						<GradientStop Offset="1" Color="#365891" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>
			<Border HorizontalAlignment="Left" Width="5">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0" Color="#2CFFFFFF" />
						<GradientStop Offset="1" Color="#1CFFFFFF" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>
			<Border BorderBrush="#3564A7" BorderThickness="1,0,0,0" />
		</Grid>
		<ControlTemplate.Triggers>
			<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
				<Setter TargetName="RootGrid" Property="RenderTransform">
					<Setter.Value>
						<ScaleTransform ScaleX="-1" />
					</Setter.Value>
				</Setter>
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style x:Key="SidebarBackground" TargetType="Control">
		<Setter Property="Template" Value="{DynamicResource SidebarBackgroundTemplate}" />
	</Style>
	<ControlTemplate x:Key="SidebarOptionsSplliterTemplate" TargetType="Control">
		<Grid x:Name="RootElement" Background="Transparent" RenderTransformOrigin="0.5,0.5">
			<Grid.RenderTransform>
				<ScaleTransform ScaleX="1" />
			</Grid.RenderTransform>
			<Rectangle x:Name="TopBlankFill" Height="3" VerticalAlignment="Top" IsHitTestVisible="False">
				<Rectangle.Fill>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0" Color="#4AFFFFFF" />
						<GradientStop Offset="1" Color="#16FFFFFF" />
					</LinearGradientBrush>
				</Rectangle.Fill>
				<Rectangle.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Offset="0" Color="#00000000" />
						<GradientStop Offset="1" Color="#FFFFFFFF" />
					</LinearGradientBrush>
				</Rectangle.OpacityMask>
			</Rectangle>
			<Rectangle x:Name="TopLine" Height="1" VerticalAlignment="Top" Margin="0,3,0,0" IsHitTestVisible="False">
				<Rectangle.Fill>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Offset="0" Color="#52FFFFFF" />
						<GradientStop Offset="1" Color="#16FFFFFF" />
					</LinearGradientBrush>
				</Rectangle.Fill>
			</Rectangle>
			<Rectangle x:Name="BottomLine" Height="1" VerticalAlignment="Top" Margin="0,4,0,0" IsHitTestVisible="False">
				<Rectangle.Fill>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Offset="0" Color="#38FFFFFF" />
						<GradientStop Offset="1" Color="#24FFFFFF" />
					</LinearGradientBrush>
				</Rectangle.Fill>
			</Rectangle>
		</Grid>
		<ControlTemplate.Triggers>
			<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
				<Setter TargetName="RootElement" Property="RenderTransform">
					<Setter.Value>
						<ScaleTransform ScaleX="-1" />
					</Setter.Value>
				</Setter>
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style x:Key="SidebarOptionsSplliter" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="5" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Margin" Value="0,25,0,0" />
		<Setter Property="Opacity" Value="0.5" />
		<Setter Property="Template" Value="{DynamicResource SidebarOptionsSplliterTemplate}" />
	</Style>
	<Style x:Key="SidebarOverflowPanelSplliter" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="4" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Opacity" Value="0.5" />
		<Setter Property="Template" Value="{DynamicResource SidebarOptionsSplliterTemplate}" />
	</Style>
	<Style x:Key="SidebarOptionsTop" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Height" Value="25" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="{TemplateBinding Background}">
						<Image x:Name="HoverBackground" Source="Images\OptionsBarHover.png" Stretch="Fill" Opacity="0" Margin="0,0,0,-5" RenderTransformOrigin="0.5,0.5"></Image>
						<StackPanel Name="OptionsBar" Height="{TemplateBinding Height}" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True" Orientation="Horizontal">
							<TextBlock x:Name="OptionsText" VerticalAlignment="Center" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="10" Foreground="{DynamicResource GlobalForegroundBrush}" Opacity="0" Text="{DynamicResource UtilStringSidebarOptions}" Visibility="Collapsed"/>
							<Border x:Name="TopOptionsImagePart" VerticalAlignment="Center" Background="Transparent">
								<Grid Margin="4,5,4,0">
									<Image x:Name="TopOptionsIcon" Source="Images\OptionsNormal.png" Stretch="None" />
									<Image x:Name="TopOptionsIconHover" Source="Images\OptionsHover.png" Opacity="0" Stretch="None" />
								</Grid>
							</Border>
						</StackPanel>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIconHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="OptionsText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetName="TopOptionsIconHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<DataTrigger Binding="{Binding IsMouseOver, ElementName=TopOptionsImagePart}" Value="True">
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
						<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
							<Setter TargetName="OptionsBar" Property="HorizontalAlignment" Value="Left" />
							<Setter TargetName="OptionsBar" Property="FlowDirection" Value="RightToLeft" />
							<Setter TargetName="HoverBackground" Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleX="-1" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarTilesRegion" TargetType="DockPanel">
		<Setter Property="Margin" Value="0,30,0,0" />
	</Style>
	<Style x:Key="SidebarTaskbarTrayBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<snt:Slice9Image x:Name="BackgroundImage" Source="Images\Taskbar.png" SliceThickness="0,6,0,0" RenderTransformOrigin="0.5,0.5"></snt:Slice9Image>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{StaticResource UtilSystemIsTaskbarTopBinding}" Value="True">
							<Setter TargetName="BackgroundImage" Property="RenderTransform">
								<Setter.Value>
									<ScaleTransform ScaleY="-1" />
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarMinRestoreButton" TargetType="Button">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
						<Image x:Name="Normal" Source="Images\RestoreNormal.png" />
						<Image x:Name="Hover" Source="Images\RestoreLight.png" Opacity="0" />
						<Image x:Name="Active" Source="Images\RestorePress.png" Opacity="0" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Width" Value="17" />
		<Setter Property="Height" Value="27" />
		<Setter Property="VerticalAlignment" Value="Center"></Setter>
		<Setter Property="Margin" Value="6,0,6,0"></Setter>
		<Setter Property="DockPanel.Dock" Value="Left"></Setter>
	</Style>
	<Style x:Key="SidebarMinAeroPeekButton" TargetType="Button">
		<Setter Property="Visibility" Value="Collapsed"></Setter>
	</Style>
	<Style x:Key="SidebarMinTaskbarTilesControl" TargetType="ItemsControl">
		<Setter Property="SnapsToDevicePixels" Value="True"></Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<Button Tag="{Binding}" ToolTip="{Binding DisplayName}" Content="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid Background="Transparent">
									<Grid>
										<Border x:Name="HoverState" Background="#5FACFF" Opacity="0"></Border>
										<Image x:Name="ActiveState" Source="Images\ItemActive.png" Stretch="Fill" Opacity="0"></Image>
									</Grid>
									<Image Source="{TemplateBinding Content}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverState" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverState" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
									<Trigger Property="IsPressed" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="ActiveState" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="ActiveState" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="SidebarOverflowTilesControl" TargetType="ItemsControl">
		<Setter Property="FlowDirection" Value="RightToLeft"></Setter>
		<Setter Property="DockPanel.Dock" Value="Bottom"></Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<WrapPanel FlowDirection="RightToLeft"></WrapPanel>
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ItemsControl">
					<StackPanel Orientation="Vertical" Background="{TemplateBinding Background}">
						<Control FlowDirection="LeftToRight" Style="{DynamicResource SidebarOverflowPanelSplliter}" />
						<ItemsPresenter FlowDirection="{TemplateBinding FlowDirection}"/>
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<Button Tag="{Binding}" ToolTip="{Binding DisplayName}" Content="{Binding Icon}" Width="16" Height="16">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Grid FlowDirection="LeftToRight">
									<Border x:Name="Hover" Background="#5FACFF" Opacity="0"></Border>
									<Image x:Name="Active" Source="Images\ItemActive.png" Opacity="0"></Image>
									<Image Source="{TemplateBinding Content}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
									<Trigger Property="IsPressed" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="Active" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- Tile -->
	<ControlTemplate x:Key="TileSplliterTemplate" TargetType="Thumb">
		<Grid x:Name="RootElement" Background="Transparent" RenderTransformOrigin="0.5,0.5">
			<Grid.RenderTransform>
				<ScaleTransform ScaleX="1" />
			</Grid.RenderTransform>
			<Rectangle x:Name="TopBlankFill" Height="3" VerticalAlignment="Top">
				<Rectangle.Fill>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0" Color="#4AFFFFFF" />
						<GradientStop Offset="1" Color="#16FFFFFF" />
					</LinearGradientBrush>
				</Rectangle.Fill>
				<Rectangle.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Offset="0" Color="#00000000" />
						<GradientStop Offset="1" Color="#FFFFFFFF" />
					</LinearGradientBrush>
				</Rectangle.OpacityMask>
			</Rectangle>
			<Rectangle x:Name="TopLine" Height="1" VerticalAlignment="Top" Margin="0,3,0,0">
				<Rectangle.Fill>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Offset="0" Color="#52FFFFFF" />
						<GradientStop Offset="1" Color="#16FFFFFF" />
					</LinearGradientBrush>
				</Rectangle.Fill>
			</Rectangle>
			<Rectangle x:Name="BottomLine" Height="1" VerticalAlignment="Top" Margin="0,4,0,0">
				<Rectangle.Fill>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Offset="0" Color="#38FFFFFF" />
						<GradientStop Offset="1" Color="#24FFFFFF" />
					</LinearGradientBrush>
				</Rectangle.Fill>
			</Rectangle>
		</Grid>
		<ControlTemplate.Triggers>
			<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
				<Setter TargetName="RootElement" Property="RenderTransform">
					<Setter.Value>
						<ScaleTransform ScaleX="-1" />
					</Setter.Value>
				</Setter>
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>
	<Style x:Key="TileSplliter" TargetType="Thumb">
		<Setter Property="DockPanel.Dock" Value="Bottom" />
		<Setter Property="Height" Value="5" />
		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Opacity" Value="0.5" />
		<Setter Property="Template" Value="{DynamicResource TileSplliterTemplate}" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.2" />
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>
			<DataTrigger Binding="{Binding IsPinned, ElementName=RootTileElement}" Value="True">
				<Setter Property="DockPanel.Dock" Value="Top" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="TileFlyoutIcon" TargetType="Control">
		<Setter Property="Visibility" Value="Collapsed"></Setter>
	</Style>
	<!-- Flyout -->
	<Style x:Key="FlyoutBackground" TargetType="Control">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<DockPanel SnapsToDevicePixels="True">
						<snt:Slice9Image Grid.Row="0" Source="Images\FlyoutBarTop.png" SliceThickness="3" Height="27" DockPanel.Dock="Top"></snt:Slice9Image>
						<snt:Slice9Image Grid.Row="2" Source="Images\FlyoutBarBottom.png" SliceThickness="3" Height="26" DockPanel.Dock="Bottom"></snt:Slice9Image>
						<Border Grid.Row="1" BorderBrush="#7C8591" BorderThickness="1" DockPanel.Dock="Top">
							<Border.Background>
								<ImageBrush ImageSource="Images\FlyoutBody.png"></ImageBrush>
							</Border.Background>
						</Border>
					</DockPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="FlyoutHeader" TargetType="Control">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid Background="{TemplateBinding Background}">
						<Image x:Name="HoverBackground" Source="Images\OptionsBarHover.png" Stretch="UniformToFill" Opacity="0" HorizontalAlignment="Right" MaxWidth="89"></Image>
						<StackPanel x:Name="OptionsBar" Height="{TemplateBinding Height}" HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="True" Orientation="Horizontal">
							<TextBlock x:Name="OptionsText" VerticalAlignment="Center" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource GlobalForegroundBrush}" Text="{DynamicResource UtilStringSidebarOptions}" Margin="3,0"></TextBlock>
							<Grid Margin="4,0" VerticalAlignment="Center">
								<Image x:Name="TopOptionsIcon" Source="Images\OptionsNormal.png" Stretch="None"></Image>
								<Image x:Name="TopOptionsIconHover" Source="Images\OptionsHover.png" Opacity="0" Stretch="None"></Image>
							</Grid>
						</StackPanel>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="TopOptionsIconHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="TopOptionsIconHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.ExitActions>
						</Trigger>
						<DataTrigger Binding="{StaticResource UtilSidebarIsReversedBinding}" Value="True">
							<Setter TargetName="OptionsBar" Property="HorizontalAlignment" Value="Left" />
							<Setter TargetName="OptionsBar" Property="FlowDirection" Value="RightToLeft" />
						</DataTrigger>
						<DataTrigger Binding="{Binding IsMouseOver, ElementName=OptionsBar}" Value="True">
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
