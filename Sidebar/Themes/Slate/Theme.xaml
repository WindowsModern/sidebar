	<!--  Power  -->
	<Style x:Key="TilePowerFoldToggleButton" TargetType="ToggleButton">
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Grid>
						<Image x:Name="ButtonImage" Stretch="Uniform" />
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="False">
							<Setter TargetName="ButtonImage" Property="Source" Value="Images/Power/UnfoldNormal.png" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsChecked" Value="False" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="ButtonImage" Property="Source" Value="Images/Power/UnfoldLight.png" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsChecked" Value="False" />
								<Condition Property="IsPressed" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="ButtonImage" Property="Source" Value="Images/Power/UnfoldPress.png" />
						</MultiTrigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="ButtonImage" Property="Source" Value="Images/Power/FoldNormal.png" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsChecked" Value="True" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="ButtonImage" Property="Source" Value="Images/Power/FoldLight.png" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsChecked" Value="True" />
								<Condition Property="IsPressed" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="ButtonImage" Property="Source" Value="Images/Power/FoldPress.png" />
						</MultiTrigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="ButtonImage" Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	
	<!--  Tray & QuickLaunch IconItem  -->
	<Style x:Key="TileIconItemButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="24" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Padding" Value="4,4,4,4" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
						<snt:Slice9Image x:Name="HoverImage" Opacity="0" SliceThickness="4" Source="{DynamicResource TileIconItemHoverImage}" />
						<snt:Slice9Image x:Name="PressedImage" Opacity="0" SliceThickness="4" Source="{DynamicResource TileIconItemActiveImage}" />
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Grid>
					<ControlTemplate.Triggers>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsMouseOver" Value="True" />
								<Condition Property="IsPressed" Value="False" />
							</MultiTrigger.Conditions>
							<Setter TargetName="HoverImage" Property="Opacity" Value="1" />
						</MultiTrigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="PressedImage" Property="Opacity" Value="1" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="TileIconItemWithTextButtonStyle" TargetType="Button">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
		<Setter Property="Padding" Value="4"></Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
						<snt:Slice9Image x:Name="HoverImage" Opacity="0" SliceThickness="4" Source="{DynamicResource TileIconItemHoverImage}" />
						<snt:Slice9Image x:Name="PressedImage" Opacity="0" SliceThickness="4" Source="{DynamicResource TileIconItemActiveImage}" />
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
					</Grid>
					<ControlTemplate.Triggers>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsMouseOver" Value="True" />
								<Condition Property="IsPressed" Value="False" />
							</MultiTrigger.Conditions>
							<Setter TargetName="HoverImage" Property="Opacity" Value="1" />
						</MultiTrigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="PressedImage" Property="Opacity" Value="1" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	
	<!--  Tray  -->
	<Style x:Key="TileIconItemForTrayTile" BasedOn="{StaticResource TileIconItemButtonStyle}" TargetType="Button">
		<Setter Property="Width" Value="24" />
		<Setter Property="Height" Value="24" />
	</Style>
	<Style x:Key="TileIconItemWithTextForTrayTile" TargetType="Button" BasedOn="{StaticResource TileIconItemWithTextButtonStyle}">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Height" Value="Auto" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
	</Style>
	<ItemsPanelTemplate x:Key="TileIconItemWrapPanelForTrayTile">
		<WrapPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" />
	</ItemsPanelTemplate>
	
	<!--  QuickLaunch  -->
	<Style x:Key="TileIconItemForQuickLaunchTile" BasedOn="{StaticResource TileIconItemButtonStyle}" TargetType="Button">
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="28" />
	</Style>
	<Style x:Key="TileIconItemWithTextForQuickLaunchTile" BasedOn="{StaticResource TileIconItemWithTextButtonStyle}" TargetType="Button" />
</ResourceDictionary>