<Window x:Class="Sidebar.HideTilesContainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sidebar" Loaded="Window_Loaded" Closed="Window_Closed"
        mc:Ignorable="d" SizeChanged="Window_SizeChanged" ResizeMode="NoResize"
		WindowStyle="None" Visibility="Hidden" ShowInTaskbar="False" Background="Black"
        Title="HideTilesContainWindow" Height="0" Width="300">
	<Window.Resources>
		<Style TargetType="Control">
			<Setter Property="Background" Value="{x:Null}"></Setter>
		</Style>
		<Style TargetType="Shape">
			<Setter Property="Fill" Value="{x:Null}"></Setter>
		</Style>
	</Window.Resources>
	<Grid>
		<DockPanel Style="{DynamicResource MainPanel}">
			<ScrollViewer HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
				<StackPanel Name="OverflowTilesRegion" Orientation="Vertical" Style="{DynamicResource TilesRegion}" VerticalAlignment="Top">
					<StackPanel.Resources>
						<!--<Style TargetType="local:Tile">
							<Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
						</Style>-->
					</StackPanel.Resources>
				</StackPanel>
			</ScrollViewer>
		</DockPanel>
	</Grid>
</Window>
