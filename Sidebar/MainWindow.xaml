<Window
	x:Class="Sidebar.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Sidebar"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:snt="clr-namespace:Sidebar;assembly=Native"
	Title="MainWindow"
	Width="150"
	Height="600"
	HorizontalAlignment="Stretch"
	VerticalAlignment="Top"
	AllowsTransparency="True"
	Background="Transparent"
	Closed="Window_Closed"
	ContentRendered="Window_ContentRendered"
	Loaded="Window_Loaded"
	MouseDoubleClick="Window_MouseDoubleClick"
	MouseMove="Window_MouseMove"
	Opacity="1"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeChanged="Window_SizeChanged"
	SourceInitialized="Window_SourceInitialized"
	Unloaded="Window_Unloaded"
	WindowStyle="None"
	mc:Ignorable="d">
	<Window.Resources>
		<local:DirectionToScaleXConverter x:Key="DirectionToScaleX" />
		<DoubleAnimation
			x:Key="LoadAnimOffset"
			BeginTime="0:0:0.05"
			Storyboard.TargetName="OpacityMaskGradStop"
			Storyboard.TargetProperty="Offset"
			To="0"
			Duration="0:0:0.25" />
		<DoubleAnimation
			x:Key="LoadAnimOffset1"
			Completed="LoadAnimation_Completed"
			Storyboard.TargetName="OpacityMaskGradStop1"
			Storyboard.TargetProperty="Offset"
			To="0"
			Duration="0:0:0.25" />
		<DoubleAnimation
			x:Key="DummyAnim"
			Completed="DummyAnimation_Completed"
			Duration="0:0:0.5" />
		<ContextMenu x:Key="TopOptionsMenu">
			<MenuItem Name="ItemMinSidebar" Click="MinimizeSidebar_Click" />
			<MenuItem Name="ItemProperties" Click="Properties_Click" />
			<MenuItem Name="ItemAddTile" Click="AddTile_Click" />
			<MenuItem Name="ItemGetTiles" Click="GetTiles_Click" />
			<MenuItem Name="ItemManageTile" SubmenuOpened="ItemManageTile_SubmenuOpened">
				<MenuItem.Items>
					<MenuItem Header="Test" />
				</MenuItem.Items>
			</MenuItem>
			<Separator />
			<MenuItem Name="ItemCancelSidebar" Click="CancelSidebar_Click" />
		</ContextMenu>
		<DataTemplate x:Key="TileMinimunItemTemplate">
			<ToggleButton
				Name="OverflowTileItem"
				Click="OverflowTileItem_Click"
				ContextMenuOpening="OverflowTileItem_ContextMenuOpening"
				Style="{DynamicResource SidebarOverflowTileItem}"
				Tag="{Binding}"
				ToolTip="{Binding TileTitle}">
				<Image
					Width="16"
					Height="16"
					Source="{Binding TileLogo}" />
			</ToggleButton>
		</DataTemplate>
	</Window.Resources>
	<Window.OpacityMask>
		<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
			<GradientStop Offset="0" Color="#00000000" />
			<GradientStop x:Name="OpacityMaskGradStop1" Offset="1" Color="#00000000" />
			<GradientStop x:Name="OpacityMaskGradStop" Offset="1" Color="#FF000000" />
			<GradientStop Offset="1" Color="#FFFFFFFF" />
		</LinearGradientBrush>
	</Window.OpacityMask>
	<Grid>
		<Grid Background="Transparent">
			<Control RenderTransformOrigin="0.5, 0.5" Style="{DynamicResource SidebarBackground}">
				<Control.RenderTransform>
					<ScaleTransform ScaleX="{Binding Source={StaticResource CurrentUserConfig}, Path=Direction, Converter={StaticResource DirectionToScaleX}}" />
				</Control.RenderTransform>
			</Control>
			<Control Style="{DynamicResource SidebarBackgroundWithoutFilp}" />
		</Grid>
		<Grid Name="Content">
			<StackPanel
				Name="Splitter"
				RenderTransformOrigin="0.5,0.5"
				Style="{DynamicResource TopOptionsPanelSplitter}">
				<StackPanel.RenderTransform>
					<ScaleTransform ScaleX="{Binding Source={StaticResource CurrentUserConfig}, Path=Direction, Converter={StaticResource DirectionToScaleX}}" />
				</StackPanel.RenderTransform>
				<Rectangle IsHitTestVisible="False" Style="{DynamicResource TileSplitterTopBlankFill}" />
				<Line Name="SplitterLine1" Style="{DynamicResource TileSplitterLineTop}" />
				<Line Name="SplitterLine2" Style="{DynamicResource TileSplitterLineBottom}" />
				<Rectangle
					Name="SplitterLineBottomFill"
					IsHitTestVisible="False"
					Style="{DynamicResource TileSplitterBottomBlankFill}" />
			</StackPanel>
			<DockPanel Name="MainPanel" Style="{DynamicResource MainPanel}">
				<ScrollViewer
					Name="PinnedTilesScrollRegion"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					VerticalContentAlignment="Bottom"
					DockPanel.Dock="Bottom"
					HorizontalScrollBarVisibility="Disabled"
					Style="{DynamicResource AutoHideScrollViewer}"
					VerticalScrollBarVisibility="Auto" />
				<StackPanel Name="PinnedTilesRegion" Style="{DynamicResource PinnedTilesRegion}" />
				<Grid
					Name="OverflowTilesRegion"
					Height="0"
					DockPanel.Dock="Bottom">
					<StackPanel Name="OverflowTilesRegionContent">
						<StackPanel
							Cursor="Arrow"
							RenderTransformOrigin="0.5,0.5"
							Style="{DynamicResource TileSplitterPanel}">
							<StackPanel.RenderTransform>
								<ScaleTransform ScaleX="{Binding Source={StaticResource CurrentUserConfig}, Path=Direction, Converter={StaticResource DirectionToScaleX}}" />
							</StackPanel.RenderTransform>
							<Rectangle IsHitTestVisible="False" Style="{DynamicResource TileSplitterTopBlankFill}" />
							<Line Style="{DynamicResource TileSplitterLineTop}" />
							<Line Style="{DynamicResource TileSplitterLineBottom}" />
							<Rectangle IsHitTestVisible="False" Style="{DynamicResource TileSplitterBottomBlankFill}" />
						</StackPanel>
						<ItemsControl
							Name="TileOverflowItems"
							ItemTemplate="{DynamicResource TileMinimunItemTemplate}"
							ItemsPanel="{DynamicResource SidebarOverflowTileItemWrapPanel}"
							Style="{DynamicResource SidebarOverflowTileItemControlContainer}" />
					</StackPanel>
					<Rectangle IsHitTestVisible="False" Style="{DynamicResource PinnedTileHighlight}">
						<Rectangle.RenderTransform>
							<ScaleTransform ScaleX="{Binding Source={StaticResource CurrentUserConfig}, Path=Direction, Converter={StaticResource DirectionToScaleX}}" />
						</Rectangle.RenderTransform>
					</Rectangle>
				</Grid>
				<ScrollViewer
					Name="TilesScrollRegion"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					VerticalContentAlignment="Top"
					DockPanel.Dock="Top"
					HorizontalScrollBarVisibility="Disabled"
					Style="{DynamicResource AutoHideScrollViewer}"
					VerticalScrollBarVisibility="Auto" />
				<StackPanel Name="TilesRegion" Style="{DynamicResource TilesRegion}" />
			</DockPanel>
			<Grid IsHitTestVisible="False" RenderTransformOrigin="0.5, 0.5">
				<Grid.RenderTransform>
					<ScaleTransform ScaleX="{Binding Source={StaticResource CurrentUserConfig}, Path=Direction, Converter={StaticResource DirectionToScaleX}}" />
				</Grid.RenderTransform>
				<Rectangle Name="TileHighlight" Style="{DynamicResource SidebarHighlight}" />
			</Grid>
			<local:TopOptions
				x:Name="TopOptionsPanel"
				ContextMenu="{StaticResource TopOptionsMenu}"
				Style="{DynamicResource TopOptionsPanel}" />
		</Grid>
	</Grid>
</Window>
