<Application x:Class="SGInstaller.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SGInstaller">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Themes.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<BooleanToVisibilityConverter x:Key="BoolToVis" />
			<local:StringResourceConverter x:Key="StrRes" />
			<DataTemplate DataType="{x:Type local:FileSelectViewModel}">
				<Grid Margin="32,24">
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
					</StackPanel>
				</Grid>
			</DataTemplate>
			<DataTemplate DataType="{x:Type local:LoadingViewModel}">
				<Grid Margin="32,24">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" HorizontalAlignment="Center" />
						<TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,12,0,0" />
					</StackPanel>
				</Grid>
			</DataTemplate>
			<DataTemplate DataType="{x:Type local:PreinstallViewModel}">
				<Grid Margin="32,24">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource TitleText}" />
					<Grid Grid.Row="1" Margin="0,16,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" VerticalAlignment="Top">
							<TextBlock Text="{Binding DisplayName}" Style="{StaticResource SubtitleText}" />
							<TextBlock Text="{Binding PublisherText}" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
							<TextBlock Text="{Binding VersionText}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
						</StackPanel>
						<Border Grid.Column="1" Width="96" Height="96" Margin="16,0,0,0" Background="Transparent" Style="{StaticResource PackageLogoStyle}">
							<Image Source="{Binding Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
						</Border>
					</Grid>
					<TextBox Grid.Row="2" Margin="0,16,0,0" Text="{Binding Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryForeground}" />
				</Grid>
			</DataTemplate>
			<DataTemplate DataType="{x:Type local:InstallingViewModel}">
				<Grid Margin="32,24">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource TitleText}" />
					<Grid Grid.Row="1" Margin="0,16,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" VerticalAlignment="Top">
							<TextBlock Text="{Binding DisplayName}" Style="{StaticResource SubtitleText}" />
							<TextBlock Text="{Binding PublisherText}" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
							<TextBlock Text="{Binding VersionText}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
						</StackPanel>
						<Border Grid.Column="1" Width="96" Height="96" Margin="16,0,0,0" Background="Transparent" Style="{StaticResource PackageLogoStyle}">
							<Image Source="{Binding Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
						</Border>
					</Grid>
					<StackPanel Grid.Row="2" VerticalAlignment="Center">
						<TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" />
						<ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="11" Margin="0,12,0,0" />
					</StackPanel>
				</Grid>
			</DataTemplate>
			<DataTemplate DataType="{x:Type local:InstallSuccessViewModel}">
				<Grid Margin="32,24">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource TitleText}" />
					<Grid Grid.Row="1" Margin="0,16,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" VerticalAlignment="Top">
							<TextBlock Text="{Binding DisplayName}" Style="{StaticResource SubtitleText}" />
							<TextBlock Text="{Binding PublisherText}" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
							<TextBlock Text="{Binding VersionText}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
						</StackPanel>
						<Border Grid.Column="1" Width="96" Height="96" Margin="16,0,0,0" Background="Transparent" Style="{StaticResource PackageLogoStyle}">
							<Image Source="{Binding Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
						</Border>
					</Grid>
				</Grid>
			</DataTemplate>
			<DataTemplate DataType="{x:Type local:InstallFailedViewModel}">
				<Grid Margin="32,24">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource TitleText}" />
					<Grid Grid.Row="1" Margin="0,16,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" VerticalAlignment="Top">
							<TextBlock Text="{Binding DisplayName}" Style="{StaticResource SubtitleText}" />
							<TextBlock Text="{Binding PublisherText}" Style="{StaticResource BodyText}" Margin="0,12,0,0" />
							<TextBlock Text="{Binding VersionText}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
						</StackPanel>
						<Border Grid.Column="1" Width="96" Height="96" Margin="16,0,0,0" Background="Transparent" Style="{StaticResource PackageLogoStyle}">
							<Image Source="{Binding Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
						</Border>
					</Grid>
					<TextBlock Grid.Row="2" Text="{Binding ReasonLabel}" Style="{StaticResource BodyText}" Margin="0,16,0,0" />
					<TextBox Grid.Row="3" Margin="0,8,0,0" Text="{Binding ReasonText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" />
				</Grid>
			</DataTemplate>
		</ResourceDictionary>
	</Application.Resources>
</Application>