<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sys="clr-namespace:System;assembly=mscorlib">

	<!-- Vista/Windows 7 风格字体 -->
	<FontFamily x:Key="GlobalFontFamily">
		Segoe UI, Microsoft YaHei, Ebrima, Nirmala UI, Meiryo, Malgun Gothic, Microsoft JhengHei, Segoe UI Symbol
	</FontFamily>

	<!-- 文字颜色 -->
	<SolidColorBrush x:Key="AppForeground" Color="#173A5E" />
	<SolidColorBrush x:Key="SecondaryForeground" Color="#536B83" />
	<SolidColorBrush x:Key="DisabledForeground" Color="#8C9AAA" />
	<SolidColorBrush x:Key="Divider" Color="#AABACB" />

	<!-- Aero 蓝色 -->
	<SolidColorBrush x:Key="AccentBrush" Color="#2F78B7" />
	<SolidColorBrush x:Key="AccentLightBrush" Color="#83C5F2" />
	<SolidColorBrush x:Key="AccentDarkBrush" Color="#1D568A" />

	<!-- 窗口背景：Vista/7 浅蓝玻璃效果 -->
	<LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#FFFFFF" Offset="0" />
		<GradientStop Color="#F5FAFF" Offset="0.22" />
		<GradientStop Color="#E7F0F8" Offset="0.62" />
		<GradientStop Color="#D6E4F0" Offset="1" />
	</LinearGradientBrush>

	<!-- 顶部柔和高光 -->
	<LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#FFFFFF" Offset="0" />
		<GradientStop Color="#F7FBFF" Offset="0.45" />
		<GradientStop Color="#E2EDF7" Offset="1" />
	</LinearGradientBrush>

	<!-- 底部命令栏 -->
	<LinearGradientBrush x:Key="CommandBarBackground" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#F8FBFE" Offset="0" />
		<GradientStop Color="#E7F0F8" Offset="0.45" />
		<GradientStop Color="#D0DFEC" Offset="1" />
	</LinearGradientBrush>

	<!-- 普通按钮 -->
	<LinearGradientBrush x:Key="ButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#FFFFFF" Offset="0" />
		<GradientStop Color="#F8FBFE" Offset="0.18" />
		<GradientStop Color="#E8F0F7" Offset="0.5" />
		<GradientStop Color="#D6E3EF" Offset="0.52" />
		<GradientStop Color="#C8D8E8" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#FFFFFF" Offset="0" />
		<GradientStop Color="#F1FAFF" Offset="0.18" />
		<GradientStop Color="#D9EEFC" Offset="0.5" />
		<GradientStop Color="#B9DCF3" Offset="0.52" />
		<GradientStop Color="#9CCBEA" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="ButtonPressBrush" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#A5CBE6" Offset="0" />
		<GradientStop Color="#C1DDF0" Offset="0.42" />
		<GradientStop Color="#D8EBF8" Offset="0.54" />
		<GradientStop Color="#F2FAFF" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="ButtonDisabledBrush" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#F3F6F9" Offset="0" />
		<GradientStop Color="#E2E8EE" Offset="1" />
	</LinearGradientBrush>

	<!-- 主按钮：Vista/7 Aero 蓝色 -->
	<LinearGradientBrush x:Key="PrimaryButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#B7E3FF" Offset="0" />
		<GradientStop Color="#75BCEB" Offset="0.18" />
		<GradientStop Color="#4A96D0" Offset="0.5" />
		<GradientStop Color="#347BB7" Offset="0.53" />
		<GradientStop Color="#225D94" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="PrimaryButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#D2F0FF" Offset="0" />
		<GradientStop Color="#9DDAF7" Offset="0.18" />
		<GradientStop Color="#65ADDF" Offset="0.5" />
		<GradientStop Color="#438BC4" Offset="0.53" />
		<GradientStop Color="#2E6FA8" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="PrimaryButtonPressBrush" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#245E94" Offset="0" />
		<GradientStop Color="#357CB5" Offset="0.45" />
		<GradientStop Color="#5AA5D7" Offset="0.58" />
		<GradientStop Color="#A9DCF5" Offset="1" />
	</LinearGradientBrush>

	<!-- 进度条 -->
	<LinearGradientBrush x:Key="ProgressBarBackground" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#AEBECD" Offset="0" />
		<GradientStop Color="#D6E0EA" Offset="0.45" />
		<GradientStop Color="#F2F6FA" Offset="1" />
	</LinearGradientBrush>

	<LinearGradientBrush x:Key="ProgressBarFill" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Color="#D6F3FF" Offset="0" />
		<GradientStop Color="#82C8EF" Offset="0.28" />
		<GradientStop Color="#3D91CC" Offset="0.55" />
		<GradientStop Color="#2369A1" Offset="1" />
	</LinearGradientBrush>

	<!-- 字体大小 -->
	<sys:Double x:Key="TitleFontSize">28</sys:Double>
	<sys:Double x:Key="SubtitleFontSize">20</sys:Double>
	<sys:Double x:Key="BodyFontSize">13</sys:Double>

	<!-- 标题 -->
	<Style x:Key="TitleText" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
		<Setter Property="FontWeight" Value="Light" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="Foreground" Value="{StaticResource AppForeground}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<!-- 副标题 -->
	<Style x:Key="SubtitleText" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="Foreground" Value="{StaticResource AppForeground}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<!-- 正文 -->
	<Style x:Key="BodyText" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="Foreground" Value="{StaticResource SecondaryForeground}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
	</Style>

	<!-- Vista/7 普通按钮 -->
	<Style x:Key="BaseButton" TargetType="Button">
		<Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
		<Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
		<Setter Property="Padding" Value="17,6" />
		<Setter Property="MinHeight" Value="29" />
		<Setter Property="MinWidth" Value="88" />
		<Setter Property="Foreground" Value="{StaticResource AppForeground}" />
		<Setter Property="Background" Value="{StaticResource ButtonFaceBrush}" />
		<Setter Property="BorderBrush" Value="#829CB5" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid>
						<Border
							x:Name="OuterBorder"
							Margin="1"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="1"
							CornerRadius="4"
							SnapsToDevicePixels="True">
							<Border
								x:Name="InnerBorder"
								BorderBrush="#FDFEFF"
								BorderThickness="1"
								CornerRadius="3"
								Opacity="0.9">
								<ContentPresenter
									Margin="{TemplateBinding Padding}"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									RecognizesAccessKey="True" />
							</Border>
						</Border>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
							<Setter TargetName="OuterBorder" Property="BorderBrush" Value="#4C9ED2" />
							<Setter TargetName="InnerBorder" Property="BorderBrush" Value="#FFFFFF" />
						</Trigger>

						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource ButtonPressBrush}" />
							<Setter TargetName="OuterBorder" Property="BorderBrush" Value="#367FB4" />
							<Setter TargetName="InnerBorder" Property="Opacity" Value="0.55" />
						</Trigger>

						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="OuterBorder" Property="BorderBrush" Value="#2375B5" />
						</Trigger>

						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource ButtonDisabledBrush}" />
							<Setter TargetName="OuterBorder" Property="BorderBrush" Value="#B7C4D0" />
							<Setter TargetName="InnerBorder" Property="BorderBrush" Value="#FFFFFF" />
							<Setter Property="Foreground" Value="{StaticResource DisabledForeground}" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Vista/7 主按钮 -->
	<Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Background" Value="{StaticResource PrimaryButtonFaceBrush}" />
		<Setter Property="BorderBrush" Value="#205583" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid>
						<Border
							x:Name="OuterBorder"
							Margin="1"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="1"
							CornerRadius="4"
							SnapsToDevicePixels="True">
							<Border
								x:Name="InnerBorder"
								BorderBrush="#B9E3FA"
								BorderThickness="1"
								CornerRadius="3"
								Opacity="0.85">
								<ContentPresenter
									Margin="{TemplateBinding Padding}"
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									RecognizesAccessKey="True" />
							</Border>
						</Border>
					</Grid>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource PrimaryButtonHoverBrush}" />
							<Setter TargetName="OuterBorder" Property="BorderBrush" Value="#266A9F" />
							<Setter TargetName="InnerBorder" Property="BorderBrush" Value="#E5F7FF" />
						</Trigger>

						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource PrimaryButtonPressBrush}" />
							<Setter TargetName="OuterBorder" Property="BorderBrush" Value="#174A78" />
							<Setter TargetName="InnerBorder" Property="Opacity" Value="0.6" />
						</Trigger>

						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="OuterBorder" Property="BorderBrush" Value="#123F69" />
						</Trigger>

						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="OuterBorder" Property="Background" Value="#C6D3DF" />
							<Setter TargetName="OuterBorder" Property="BorderBrush" Value="#9EAFBF" />
							<Setter TargetName="InnerBorder" Property="BorderBrush" Value="#E5ECF2" />
							<Setter Property="Foreground" Value="#718295" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- 所有普通 Button 默认使用 Aero 样式 -->
	<Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

	<!-- Vista/7 风格进度条 -->
	<Style TargetType="ProgressBar">
		<Setter Property="Background" Value="{StaticResource ProgressBarBackground}" />
		<Setter Property="Foreground" Value="{StaticResource ProgressBarFill}" />
		<Setter Property="BorderBrush" Value="#8298AD" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ProgressBar">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="4"
						SnapsToDevicePixels="True">
						<Grid Margin="1">
							<Rectangle
								Fill="#EFF5FA"
								Opacity="0.55"
								RadiusX="2"
								RadiusY="2" />
							<Rectangle
								x:Name="PART_Indicator"
								HorizontalAlignment="Left"
								Fill="{TemplateBinding Foreground}"
								RadiusX="2"
								RadiusY="2" />
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- 安装包图标：轻微缩放淡入 -->
	<Style x:Key="PackageLogoStyle" TargetType="Border">
		<Setter Property="Opacity" Value="0" />
		<Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
		<Setter Property="RenderTransform">
			<Setter.Value>
				<ScaleTransform ScaleX="0.88" ScaleY="0.88" />
			</Setter.Value>
		</Setter>
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect
					BlurRadius="8"
					Direction="270"
					ShadowDepth="2"
					Opacity="0.25"
					Color="#50708E" />
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<EventTrigger RoutedEvent="Loaded">
				<BeginStoryboard>
					<Storyboard>
						<DoubleAnimation
							Storyboard.TargetProperty="Opacity"
							From="0"
							To="1"
							Duration="0:0:0.35">
							<DoubleAnimation.EasingFunction>
								<CubicEase EasingMode="EaseOut" />
							</DoubleAnimation.EasingFunction>
						</DoubleAnimation>

						<DoubleAnimation
							Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
							From="0.88"
							To="1"
							Duration="0:0:0.35">
							<DoubleAnimation.EasingFunction>
								<CubicEase EasingMode="EaseOut" />
							</DoubleAnimation.EasingFunction>
						</DoubleAnimation>

						<DoubleAnimation
							Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
							From="0.88"
							To="1"
							Duration="0:0:0.35">
							<DoubleAnimation.EasingFunction>
								<CubicEase EasingMode="EaseOut" />
							</DoubleAnimation.EasingFunction>
						</DoubleAnimation>
					</Storyboard>
				</BeginStoryboard>
			</EventTrigger>
		</Style.Triggers>
	</Style>

</ResourceDictionary>