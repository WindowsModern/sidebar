<UserControl x:Class="Sidebar.ImageButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sidebar"
             mc:Ignorable="d" 
             Focusable="True" 
             x:Name="RootElement"
             d:DesignHeight="300" d:DesignWidth="300"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
             MouseLeftButtonUp="UserControl_MouseLeftButtonUp"
             TouchEnter="UserControl_TouchEnter"
             TouchLeave="UserControl_TouchLeave"
             TouchUp="UserControl_TouchUp"
             TouchDown="UserControl_TouchDown"
             GotFocus="UserControl_GotFocus"
             LostFocus="UserControl_LostFocus">
	<Border>
		<Grid Background="Transparent">
			<!-- Normal -->
			<Image x:Name="ImageNormal" 
                   Source="{Binding NormalSource, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
                   Stretch="{Binding NormalStretch, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
				   RenderOptions.BitmapScalingMode="HighQuality"
                   Opacity="1"/>
			<!-- Focus -->
			<Image x:Name="ImageFocus" 
                   Source="{Binding FocusSource, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
                   Stretch="{Binding FocusStretch, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
				   RenderOptions.BitmapScalingMode="HighQuality"
                   Opacity="0"/>
			<!-- Hover -->
			<Image x:Name="ImageHover" 
                   Source="{Binding HoverSource, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
                   Stretch="{Binding HoverStretch, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
				   RenderOptions.BitmapScalingMode="HighQuality"
                   Opacity="0"/>
			<!-- Active (Pressed) -->
			<Image x:Name="ImageActive" 
                   Source="{Binding ActiveSource, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
                   Stretch="{Binding ActiveStretch, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
				   RenderOptions.BitmapScalingMode="HighQuality"
                   Opacity="0"/>
			<!-- Disabled -->
			<Image x:Name="ImageDisabled" 
                   Source="{Binding DisabledSource, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
                   Stretch="{Binding DisabledStretch, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
				   RenderOptions.BitmapScalingMode="HighQuality"
                   Opacity="0"/>
			<!-- Content -->
			<ContentPresenter Name="ContentRegion"
                  HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
                  VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
                  Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=local:ImageButton}}"
                  Content="{Binding Child, RelativeSource={RelativeSource AncestorType=local:ImageButton}}" />
		</Grid>
	</Border>
</UserControl>