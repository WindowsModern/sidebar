<UserControl x:Class="WindowsModern.UserTile.FlyoutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsModern.UserTile"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
	<UserControl.Resources>

	</UserControl.Resources>
    <Grid>
		<DockPanel Margin="6">
			<DockPanel DockPanel.Dock="Top" VerticalAlignment="Top">
				<Viewbox Style="{DynamicResource TileUserFlyoutUserImageView}">
					<Grid Width="Auto" Height="Auto">
						<Image Name="UserImage" Style="{DynamicResource TileUserFlyoutUserImage}"></Image>
						<Image Name="BorderImage" Style="{DynamicResource TileUserFlyoutUserImageBorder}"></Image>
					</Grid>
				</Viewbox>
				<WrapPanel Margin="5,0,5,0">
					<TextBlock Name="UserName" TextWrapping="Wrap" Style="{DynamicResource TileUserFlyoutUserName}">User</TextBlock>
				</WrapPanel>
			</DockPanel>
			<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
				<StackPanel Orientation="Vertical" Margin="5,5,0,0">
					<Button Name="UserFolderButton" Click="UserFolderButton_Click" Style="{DynamicResource TileUserFlyoutButtonStyle}">User Folder</Button>
					<Button Name="UserSettingsButton" Click="UserSettingsButton_Click" Style="{DynamicResource TileUserFlyoutButtonStyle}" Margin="0,5">User Settings</Button>
					<Button Name="UserSwitchButton" Click="UserSwitchButton_Click" Style="{DynamicResource TileUserFlyoutButtonStyle}">Switch User</Button>
				</StackPanel>
			</StackPanel>
		</DockPanel>
    </Grid>
</UserControl>
