<UserControl x:Class="WindowsModern.UserTile.TilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsModern.UserTile"
             mc:Ignorable="d" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded"
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid Margin="8,8,2,8">
		<DockPanel Name="WelcomePart" Margin="2" Opacity="0" Visibility="Collapsed">
			<Image Name="WelcomeUserImage" Style="{DynamicResource TileUserWelcomeUserImage}"></Image>
			<StackPanel Orientation="Vertical">
				<TextBlock Name="WelcomeText" Style="{DynamicResource TileUserWelcomeUserWelcomeText}">Welcome,</TextBlock>
				<TextBlock Name="WelcomeUser" TextWrapping="Wrap" Style="{DynamicResource TileUserWelcomeUserUserText}">User</TextBlock>
			</StackPanel>
		</DockPanel>
		<DockPanel VerticalAlignment="Center" Name="CommonPanel" Opacity="0" Visibility="Collapsed">
			<Image Name="UserImage" Style="{DynamicResource TileUserCommonUserImage}"></Image>
			<WrapPanel>
				<TextBlock Name="UserName" HorizontalAlignment="Stretch" TextWrapping="Wrap" Style="{DynamicResource TileUserCommonUserText}">Administrator</TextBlock>
			</WrapPanel>
		</DockPanel>
    </Grid>
</UserControl>
