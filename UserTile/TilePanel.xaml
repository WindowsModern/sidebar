<UserControl x:Class="WindowsModern.UserTile.TilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsModern.UserTile"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Margin="5">
		<StackPanel Orientation="Horizontal">
			<Image Width="28" Height="28" Margin="0,0,3,0" Stretch="UniformToFill"></Image>
			<TextBlock FontFamily="{DynamicResource GlobalFontFamily}">Administrator</TextBlock>
		</StackPanel>
    </Grid>
</UserControl>
