<UserControl x:Class="WindowsModern.NotificationHistoryTile.TilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsModern.NotificationHistoryTile"
			 xmlns:nt="clr-namespace:Sidebar;assembly=Native"
			 ClipToBounds="True"
             mc:Ignorable="d" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded"
			 MinHeight="35" 
             d:DesignHeight="300" d:DesignWidth="300">
	<Grid>
		<Button Visibility="Hidden" Name="NotificationStyleButton" Style="{DynamicResource TileNotificationButton}" HorizontalAlignment="Left" VerticalAlignment="Top"></Button>
		<Canvas SizeChanged="Canvas_SizeChanged" Name="NoticePanel" Style="{DynamicResource TileNotificationTileArea}">

		</Canvas>
	</Grid>
</UserControl>
